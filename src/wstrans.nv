// wstrans.nv — the transports a connection runs over, and the trait that
// lets a program supply its own.
//
// `WsTransport[e]` is the hook. `wss://` is `WsTls`, `ws://` is `WsTcp`,
// and a program that terminates TLS at a load balancer, speaks WebSocket
// over a unix socket, or replays a recorded conversation in a test
// supplies its own and pays for nothing it does not use.
//
// A transport moves bytes and does not frame them. A `ws_recv` that
// returned one frame would be a second decoder beside websocket-codec-nv's.
// Over a transport that hands back bytes from memory, a conversation of any
// timing is a table of bytes and a table of milliseconds.

use std.tls
use std.bytes
use h1read
use wsconnerr

// A byte pipe a WebSocket connection can be driven over.
//
// `e` is the effect row the implementation supplies, and it is what a
// call in `wsconn` costs: `[io, net]` over a TCP stream, `[net]` over
// TLS, nothing at all over a buffer.  SPEC § 5.6.
pub trait WsTransport[e]
    // Hand the transport bytes.  The answer is how many it took; a
    // short write is not a failure, and the caller sends the rest.
    fn ws_send(self, data: Bytes) -> Result<Int, IoError> [e]
    // Up to `max` bytes. `Err(IoClosed)` means the peer closed the TCP
    // connection, which RFC 6455 section 7.1.5 makes a distinct outcome
    // from a close frame: the first is 1006 and may never be sent, the
    // second is whatever code the peer chose. `Err(IoTimedOut)` means
    // nothing arrived before the transport's receive deadline, and the
    // connection is still usable. An empty answer from a transport that
    // reports itself closed is read as `Err(IoClosed)`.
    fn ws_recv(self, max: Int) -> Result<Bytes, IoError> [e]
    // Close it.  Calling this twice is not an error.
    fn ws_close(self) -> ?IoError [e]
    // Whether the transport believes it is open.  The one method with
    // no effect row, because a close handshake asks it on every turn.
    fn ws_is_open(self) -> Bool

// The head of an HTTP message read off a transport, and the bytes that
// followed it in the same reads. A server that sends frames right after
// its 101 makes those bytes the start of the first turn.
pub struct WsHead
    event: H1Event
    rest: [u8]

// Everything in `data` handed to the transport, looping over short writes.
//
// ```novo ignore
// use wstrans
//
// fn say(t: WsTcp, data: [u8]) -> ?IoError [io, net]
//     wstrans.send_all(t, data)
// ```
pub fn send_all<T: WsTransport[e]>(t: T, data: [u8]) -> ?IoError [e]
    let all = bytes.from_byte_list(data)
    let n = bytes.len(all)
    var sent = 0
    while sent < n
        match t.ws_send(bytes.slice(all, sent, n))
            Err(err) =>
                return Some(err)
            Ok(k)    =>
                if k <= 0
                    return Some(IoBrokenPipe)
                sent = sent + k
    None

// One more read toward a complete head: the bytes seen so far, plus what
// the transport hands over now.
fn read_more<T: WsTransport[e]>(t: T, role: H1Role, before: [u8]) -> Result<WsHead, WsConnError> [e]
    match t.ws_recv(4096)
        Err(err)  =>
            Err(WsSocketFailed(err))
        Ok(chunk) =>
            if bytes.len(chunk) == 0
                return Err(WsSocketFailed(IoClosed))
            let seen = list.concat(before, bytes.to_byte_list(chunk))
            match h1read.parse_head(seen, role, h1read.default_limits())
                Err(err) =>
                    Err(WsSocketFailed(IoInvalidInput(err.message())))
                Ok(step) =>
                    match step.event
                        None     =>
                            read_more(t, role, seen)
                        Some(ev) =>
                            let at = h1read.offset(step.reader)
                            Ok(WsHead { event: ev, rest: seen[at:list.len(seen)] })

// Read from the transport until the head of an HTTP message is complete.
//
// `ReadsResponses` reads a response head and `ReadsRequests` a request
// head. A transport that closes first, or a head that is not HTTP, is an
// error.
//
// ```novo ignore
// use wstrans
//
// fn head(t: WsTcp) -> Result<WsHead, WsConnError> [io, net]
//     wstrans.read_head(t, ReadsResponses)
// ```
pub fn read_head<T: WsTransport[e]>(t: T, role: H1Role) -> Result<WsHead, WsConnError> [e]
    read_more(t, role, [])

// WebSocket over a plain TCP socket — the `ws://` scheme.
pub struct WsTcp
    stream: TcpStream

// WebSocket over TLS — the `wss://` scheme.
//
// The handle is an `Int` because that is what `std.tls` answers; the
// hostname travels beside it so a reconnection verifies the same name
// without the caller having to remember which one it used.
pub struct WsTls
    conn: Int
    hostname: Str

// A listening socket, for the server half.
pub struct WsListener
    listener: TcpListener

// The default port for `ws://`, 80.
pub const WS_PORT = 80

// The default port for `wss://`, 443.
pub const WSS_PORT = 443

// The parts of a `ws://` or `wss://` address a dial needs.
//
// A struct rather than four arguments, because the four are always
// derived from one URL and a caller that split them itself would split
// them slightly differently each time — the default port in particular,
// which depends on the scheme.
pub struct WsAddress
    // True for `wss://`.
    secure: Bool
    host: Str
    port: Int
    // The request target: the path and query, `/` when there is none.
    target: Str

// The port in an authority's text, or -1 when it is not one. An empty
// text is the scheme's default, and 0 is not a port a socket connects to.
fn port_of(text: Str, default_port: Int) -> Int
    if text == ""
        return default_port
    match str.to_int(text)
        None    => -1
        Some(n) =>
            if n < 1 or n > 65535
                -1
            else
                n

// The address once the scheme is off: host, optional port, then the
// request target.
fn address_after_scheme(rest: Str, secure: Bool) -> ?WsAddress
    var default_port = WS_PORT
    if secure
        default_port = WSS_PORT
    var body = rest
    match str.index(body, "#")
        None     => ()
        Some(at) =>
            body = str.slice(body, 0, at)
    var authority = body
    var target = "/"
    match str.index(body, "/")
        Some(at) =>
            authority = str.slice(body, 0, at)
            target = str.slice(body, at, str.len(body))
        None     =>
            match str.index(body, "?")
                None     => ()
                Some(at) =>
                    authority = str.slice(body, 0, at)
                    target = "/" + str.slice(body, at, str.len(body))
    if str.contains(authority, "@")
        return None
    var host = authority
    var port = default_port
    if str.starts_with(authority, "[")
        // A bracketed IPv6 literal: the host is what is inside.
        match str.index(authority, "]")
            None     =>
                return None
            Some(at) =>
                host = str.slice(authority, 1, at)
                let after = str.slice(authority, at + 1, str.len(authority))
                if after != ""
                    if not str.starts_with(after, ":")
                        return None
                    port = port_of(str.slice(after, 1, str.len(after)), default_port)
    else
        match str.index(authority, ":")
            None     => ()
            Some(at) =>
                host = str.slice(authority, 0, at)
                port = port_of(str.slice(authority, at + 1, str.len(authority)), default_port)
    if host == "" or port < 0
        return None
    Some(WsAddress { secure: secure, host: host, port: port, target: target })

// The address a `ws://` or `wss://` URL names.
//
// The default port comes from the scheme, which is the part a caller
// gets wrong: `wss://example.com/chat` is port 443 and not 80, and a
// client that defaulted to 80 for both fails against every server that
// is only listening on one.
//
// ```novo
// use wstrans
//
// fn main() [io]
//     match wstrans.address_of("wss://example.com/chat")
//         Some(a) => println("${a.port}")
//         None    => println("not a websocket url")
// ```
pub fn address_of(url: Str) -> ?WsAddress []
    let lowered = str.lower(url)
    if str.starts_with(lowered, "wss://")
        address_after_scheme(str.slice(url, 6, str.len(url)), true)
    else if str.starts_with(lowered, "ws://")
        address_after_scheme(str.slice(url, 5, str.len(url)), false)
    else
        None

// Open a TCP connection.
//
// `[io, net]`, which is `std.net`'s own row.
//
// ```novo
// use wstrans
//
// fn main() [io]
//     println("${wstrans.WS_PORT}")
// ```
pub fn dial_tcp(host: Str, port: Int) -> Result<WsTcp, IoError> [io, net]
    match TcpStream.connect(host, port)
        Some(stream) => Ok(WsTcp { stream: stream })
        None         => Err(IoOther("could not connect to ${host}:${port}"))

// Open a TLS connection.
//
// `[net]` and not `[io, net]`, which is `std.tls`'s own row.  The
// narrower row is not a rounding: a caller in a sandbox that grants
// `[net]` and refuses `[io]` can run this and not `dial_tcp`.
//
// THE OPTIONS ARE THE STANDARD LIBRARY'S `TlsConfig`, named bare after
// `use std.tls` — not a record this package declares.  `hostname` is
// both the SNI sent and the name the peer's certificate is matched
// against, one field, because a program that could set them apart
// would have a way to verify the wrong name.  An empty
// `ca_bundle_path` means the platform's trust store; a caller pinning
// its own roots gives the path to a PEM bundle.  `cert_path` and
// `key_path` are the server half and a `wss://` dial leaves them
// empty.
//
// ```novo
// use wstrans
//
// fn main() [io]
//     println("${wstrans.WSS_PORT}")
// ```
pub fn dial_tls(host: Str, port: Int, cfg: TlsConfig) -> Result<WsTls, IoError> [net]
    match tls.connect(host, port, cfg)
        // cov: skip — reached only with a TLS peer, which tests/tls_loopback.sh provides.
        Some(conn) => Ok(WsTls { conn: conn, hostname: cfg.hostname })
        None       => Err(IoOther("TLS to ${host}:${port} failed: ${tls.last_error()}"))

// A client-side TLS configuration for a hostname, with peer
// verification on.
//
// It is `tls.config_for_client(hostname)` and nothing else — the same
// struct, the same defaults — kept so a `wss://` dial reads in one
// `use`: a caller that only dials does not have to have read `std.tls`
// first.  A caller pinning its own roots sets `ca_bundle_path` on the
// answer, or builds the `TlsConfig` field by field.
//
// ```novo
// use wstrans
//
// fn main() [io]
//     let cfg = wstrans.tls_for("example.com")
//     println("${wstrans.WSS_PORT}")
// ```
pub fn tls_for(hostname: Str) -> TlsConfig []
    tls.config_for_client(hostname)

// Listen for connections on a port.
//
// ```novo
// use wstrans
//
// fn main() [io]
//     println("${wstrans.WS_PORT}")
// ```
pub fn listen(host: Str, port: Int) -> Result<WsListener, IoError> [io, net]
    match TcpListener.listen_on(host, port)
        Some(listener) => Ok(WsListener { listener: listener })
        None           => Err(IoOther("could not listen on ${host}:${port}"))

// Take the next connection, with the peer's address beside it.
//
// ```novo ignore
// use wstrans
//
// fn next(l: WsListener) -> Result<WsAccepted, IoError> [io, net]
//     wstrans.accept(l)
// ```
pub fn accept(l: WsListener) -> Result<WsAccepted, IoError> [io, net]
    match l.listener.accept()
        Some(pair) => Ok(WsAccepted { transport: WsTcp { stream: pair.0 }, peer: pair.1 })
        None       => Err(IoOther("accept failed"))

// A connection that has been accepted and not yet upgraded.
pub struct WsAccepted
    transport: WsTcp
    peer: Str

// The TcpStream inside, for a caller that has to set a socket option
// this package does not wrap.
//
// ```novo
// use wstrans
//
// fn main() [io]
//     println("${wstrans.WS_PORT}")
// ```
pub fn stream_of(t: WsTcp) -> TcpStream []
    t.stream

// WebSocket over a TCP stream.
//
// ```novo ignore
// use wsconn
// use wstrans
//
// fn turn(c: WsConn, t: WsTcp, now_ms: Int) [io, net]
//     match wsconn.pump(c, t, now_ms)
//         Ok(_)  => nothing()
//         Err(_) => nothing()
// ```
impl WsTransport[io, net] for WsTcp
    fn ws_send(self, data: Bytes) -> Result<Int, IoError> [io, net]
        if self.stream.send_bytes(data)
            Ok(bytes.len(data))
        else
            Err(IoBrokenPipe)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError> [io, net]
        match self.stream.recv_bytes(max)
            Some(chunk) => Ok(chunk)
            None        =>
                // The runtime answers None for a closed peer, a failure
                // and a receive deadline alike. The deadline is the one
                // that leaves the connection usable.
                if net.recv_would_block()
                    Err(IoTimedOut)
                else
                    Err(IoClosed)

    fn ws_close(self) -> ?IoError [io, net]
        self.stream.close()
        None

    fn ws_is_open(self) -> Bool
        self.stream.is_open()

// WebSocket over TLS.
//
// ```novo ignore
// use wsconn
// use wstrans
//
// fn turn(c: WsConn, t: WsTls, now_ms: Int) [net]
//     match wsconn.pump(c, t, now_ms)
//         Ok(_)  => nothing()
//         Err(_) => nothing()
// ```
// cov: skip — reached only with a TLS peer, which tests/tls_loopback.sh provides.
impl WsTransport[net] for WsTls
    fn ws_send(self, data: Bytes) -> Result<Int, IoError> [net]
        if tls.send(self.conn, data)
            Ok(bytes.len(data))
        else
            Err(IoBrokenPipe)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError> [net]
        match tls.recv(self.conn, max)
            Some(chunk) => Ok(chunk)
            None        =>
                // `tls.last_error()` names an end of stream, clean or not,
                // and a receive deadline.  A compiler that predates the
                // two newer messages names only the clean close, so any
                // other empty read is taken for a deadline there.
                let why = tls.last_error()
                if why == "tls: peer closed cleanly" or why == "tls: peer closed without close_notify"
                    Err(IoClosed)
                else
                    Err(IoTimedOut)

    fn ws_close(self) -> ?IoError [net]
        tls.close(self.conn)
        None

    fn ws_is_open(self) -> Bool
        self.conn >= 0

        todo("websocket-nv.wstrans.WsTls.ws_send")

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError> [net]
        todo("websocket-nv.wstrans.WsTls.ws_recv")

    fn ws_close(self) -> ?IoError [net]

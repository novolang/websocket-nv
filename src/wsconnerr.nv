// wsconnerr.nv — the ways a connection fails once there is a socket under
// it, and the close code each one owes the peer.
//
// websocket-codec-nv has three error types. `WsDecodeError` is a frame
// that was wrong, `WsEncodeError` is a frame this program tried to build
// wrongly, and `WsHandshakeError` is an upgrade that did not happen. All
// three are arithmetic over bytes the caller already held. This type is
// what can go wrong once a socket exists: the peer that stopped
// answering, the close handshake that timed out, the extension that was
// negotiated and then misbehaved. A variant carries the codec's own error
// where one caused it.
//
// Every variant name begins with `Ws`. The codec's variants are unprefixed
// (`NeedMore`, `ProtocolError`, `Complete`, `InternalError`), and a variant
// is constructed by name across the whole assembly.

use wsclose
use wserr

// Why a connection ended, or could not start.
pub enum WsConnError
    // The transport said no.
    WsSocketFailed(cause: IoError)
    // The upgrade did not happen.  The codec's type, carried rather
    // than copied: it already distinguishes a missing key from a wrong
    // accept value from a version the server refuses.
    WsUpgradeRefused(cause: WsHandshakeError)
    // The server answered the upgrade with an ordinary HTTP response.
    // Kept apart from `WsUpgradeRefused` because the status and the
    // body are the server's explanation — a 401 with a WWW-Authenticate
    // header is a connection the caller can retry with credentials, and
    // a caller handed only "the handshake failed" cannot.
    WsUpgradeAnswered(status: Int, body: [u8])
    // A frame was wrong.  `wsclose.close_code_for` says what the peer
    // is owed for it, and `pump` sends that before it reports this.
    WsFrameRefused(cause: WsDecodeError)
    // This program asked for a frame that cannot be built.
    WsFrameNotBuildable(cause: WsEncodeError)
    // The peer sent a close and never answered ours, or answered ours
    // and never closed the socket.  RFC 6455 § 7.1.1 says an endpoint
    // may drop the connection after a reasonable time; this is that
    // time having passed.
    WsCloseTimedOut(waited_ms: Int)
    // A ping went unanswered for longer than the options allow.  Not a
    // protocol fault — the RFC requires no ping at all — but the only
    // way to tell a quiet peer from a dead network.
    WsPongTimedOut(waited_ms: Int)
    // The peer sent a compressed frame on a connection where
    // permessage-deflate was not negotiated, or a compression
    // parameter this package cannot honour.
    WsExtensionNotNegotiated(name: Str)
    // permessage-deflate was negotiated and the DEFLATE stream inside
    // it did not decompress.
    WsInflateFailed(cause: FlateError)
    // A message reassembled past `WsLimits.max_message`.  The caller's
    // own limit, reported rather than enforced silently, because the
    // right answer is sometimes to raise it.
    WsMessageTooLargeToAssemble(len: Int, limit: Int)
    // A text message whose bytes are not UTF-8. RFC 6455 section 8.1
    // makes that a failed connection with code 1007.
    WsTextNotUtf8
    // The handshake request or response could not be written as HTTP,
    // because a header name, a header value or the target is not legal.
    WsHeadNotBuildable(cause: H1EncodeError)
    // A send on a connection that is closing or closed.  After a close
    // frame has gone out, nothing else may follow it.
    WsAlreadyClosing
    // A close the peer initiated, reported as an error only to a caller
    // that asked for `receive` and will never get one.  `WsConn.close`
    // in `wsconn` is the ordinary path and this is not it.
    WsPeerClosedFirst(close: WsClose)

// Whether a peer's close code asks the other end to try again later: the
// peer is going away, restarting, or is overloaded (RFC 6455 section 7.4.1
// for 1001, and the IANA registry for 1012 and 1013).
fn try_again_code(c: WsCloseCode) -> Bool
    match c
        GoingAway      => true
        ServiceRestart => true
        TryAgainLater  => true
        _              => false

// The one-line reading, for a log or a person.
//
// ```novo
// use wsconnerr
//
// fn main() [io]
//     let e: WsConnError = WsAlreadyClosing
//     println(e.message())
// ```
impl Error for WsConnError
    fn message(self) -> Str
        match self
            WsSocketFailed(cause)               => "the transport failed: ${cause.message()}"
            WsUpgradeRefused(cause)             => "the upgrade was refused: ${cause.message()}"
            WsUpgradeAnswered(status, body)     => "the server answered the upgrade with ${status} and ${list.len(body)} bytes"
            WsFrameRefused(cause)               => "a frame was refused: ${cause.message()}"
            WsFrameNotBuildable(cause)          => "a frame could not be built: ${cause.message()}"
            WsCloseTimedOut(waited_ms)          => "no close arrived in ${waited_ms} ms"
            WsPongTimedOut(waited_ms)           => "no pong arrived in ${waited_ms} ms"
            WsExtensionNotNegotiated(name)      => "the peer used ${name}, which was not negotiated"
            WsInflateFailed(cause)              => "a compressed message did not inflate: ${cause.message()}"
            WsMessageTooLargeToAssemble(n, cap) => "a message of ${n} bytes is past the limit of ${cap}"
            WsTextNotUtf8                       => "a text message is not valid UTF-8"
            WsHeadNotBuildable(cause)           => "the handshake could not be written: ${cause.message()}"
            WsAlreadyClosing                    => "the connection is closing and nothing more may be sent"
            WsPeerClosedFirst(close)            => "the peer closed with code ${wsclose.number_of(close.code)}"

// The close code this endpoint owes the peer for this fault, or `None`
// where no close frame may be sent at all.
//
// `None` is the important half.  RFC 6455 § 7.4.1 reserves 1005, 1006
// and 1015 as values an application reports to its own code and an
// endpoint must never put on a wire, and a socket that has already
// failed cannot carry a frame anyway — so a `WsSocketFailed` answers
// `None` and a caller that sent something would be writing into a pipe
// that is gone.
//
// ```novo
// use wsconnerr
//
// fn main() [io]
//     match wsconnerr.close_code_for(WsAlreadyClosing)
//         Some(_) => println("tell the peer")
//         None    => println("nothing to send")
// ```
pub fn close_code_for(e: WsConnError) -> ?WsCloseCode []
    match e
        WsSocketFailed(_)                 => None
        WsUpgradeRefused(_)               => None
        WsUpgradeAnswered(_, _)           => None
        WsFrameRefused(cause)             => Some(wsclose.close_code_for(cause))
        WsFrameNotBuildable(_)            => Some(InternalError)
        WsCloseTimedOut(_)                => None
        WsPongTimedOut(_)                 => None
        WsExtensionNotNegotiated(_)       => Some(ProtocolError)
        WsInflateFailed(_)                => Some(InvalidPayload)
        WsMessageTooLargeToAssemble(_, _) => Some(MessageTooBig)
        WsTextNotUtf8                     => Some(InvalidPayload)
        WsHeadNotBuildable(_)             => None
        WsAlreadyClosing                  => None
        WsPeerClosedFirst(_)              => None

// True when opening a NEW connection could succeed where this one
// failed.
//
// A dropped socket and a timed-out pong are worth another attempt; a
// server that answered the upgrade with 403, or a peer that closed
// with 1008, has made a decision the same request will get again.
//
// ```novo
// use wsconnerr
//
// fn main() [io]
//     println("${wsconnerr.is_reconnectable(WsAlreadyClosing)}")
// ```
pub fn is_reconnectable(e: WsConnError) -> Bool []
    match e
        WsSocketFailed(_)                 => true
        WsUpgradeRefused(_)               => false
        WsUpgradeAnswered(status, _)      => status >= 500 or status == 408 or status == 429
        WsFrameRefused(_)                 => false
        WsFrameNotBuildable(_)            => false
        WsCloseTimedOut(_)                => true
        WsPongTimedOut(_)                 => true
        WsExtensionNotNegotiated(_)       => false
        WsInflateFailed(_)                => false
        WsMessageTooLargeToAssemble(_, _) => false
        WsTextNotUtf8                     => false
        WsHeadNotBuildable(_)             => false
        WsAlreadyClosing                  => false
        WsPeerClosedFirst(close)          => try_again_code(close.code)

// The HTTP status a SERVER would answer a failed upgrade with, or
// `None` for a fault that happened after the handshake succeeded.
//
// The codec's `wserr.http_status_for` answers this for a handshake
// error; this is the same question asked of the wider type, so a
// server's accept loop has one call rather than a match that has to
// know which faults are handshake faults.
//
// ```novo
// use wsconnerr
//
// fn main() [io]
//     match wsconnerr.http_status_for(WsAlreadyClosing)
//         Some(_) => println("answer it")
//         None    => println("too late for a status")
// ```
pub fn http_status_for(e: WsConnError) -> ?Int []
    match e
        WsUpgradeRefused(cause) => wserr.http_status_for(cause)
        _                       => None

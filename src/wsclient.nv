// wsclient.nv — the client side of the upgrade: an HTTP/1.1 request, sixteen
// random bytes, and the checks on the answer.
//
// The randomness is this package's and the arithmetic is the codec's.
// websocket-codec-nv takes the nonce as an argument, because it has no
// `[rand]` row and because a handshake that drew its own entropy could not be
// tested against RFC 6455 section 1.3's own example. This package may draw
// it, so `connect` does, and `handshake_with_nonce` is beside it so the
// exchange stays assertable.
//
// Every client frame is masked with a four-byte key (section 5.3). The mask
// is not encryption. It exists so that an intermediary that does not
// understand WebSocket cannot be tricked into reading frame contents as a
// second HTTP request, which is why it is mandatory and why the key must be
// unpredictable. `mask_keys` draws keys for a caller that frames by hand.
// `wsconn` derives its own from a seed that `handshake` draws, so sending on
// a connection needs no `[rand]` row.

use std.bytes
use h1msg
use h1write
use wshandshake
use wsconn
use wsconnerr
use wsdeflate
use wstrans

// What a client offers in the handshake beyond the URL.
pub struct WsClientRequest
    // The address, from `wstrans.address_of`.
    address: WsAddress
    // Subprotocols this client speaks, most preferred first.  The
    // server picks one or none, and a server that picks one the client
    // did not offer is a failed handshake.
    protocols: [Str]
    // Extra request headers: `Authorization`, `Cookie`, `Origin`.
    // `H1Headers` from http-codec-nv, so a caller that already built
    // headers for an HTTP request reuses the type.
    headers: H1Headers
    // Whether to offer permessage-deflate, and with what parameters.
    deflate: ?WsDeflateParams

// A handshake that has been prepared and not yet sent.
//
// Published because the exchange is worth being able to inspect: the
// request is what goes on the wire, and the nonce is what the answer
// has to be checked against.
pub struct WsClientHandshake
    request: H1Request
    nonce_key: Str
    offered_protocols: [Str]
    offered_deflate: ?WsDeflateParams
    // The seed of the mask keys the connection will use.
    mask_seed: Str

// The `Host` field value: the host, with brackets around an IPv6 literal,
// and the port unless it is the scheme's default.
fn host_header(a: WsAddress) -> Str
    var host = a.host
    if str.contains(host, ":")
        host = "[" + host + "]"
    var default_port = WS_PORT
    if a.secure
        default_port = WSS_PORT
    if a.port == default_port
        host
    else
        "${host}:${a.port}"

// The request's headers with the caller's added, and the extension offered.
fn headers_for(r: WsClientRequest, base: H1Headers) -> H1Headers
    var h = base
    for f in h1msg.fields_of(r.headers)
        if h1msg.name_eq(f.name, "Host")
            h = h1msg.set(h, f.name, f.value)
        else
            h = h1msg.append(h, f.name, f.value)
    match r.deflate
        Some(p) =>
            h = h1msg.set(h, wsdeflate.extensions_header(), wsdeflate.offer_header(p))
        None    => ()
    h

// The handshake for a nonce and the seed of the mask keys.
fn handshake_seeded(r: WsClientRequest, nonce_bytes: [u8],
                    seed: Str) -> Result<WsClientHandshake, WsConnError>
    match wshandshake.client_key(nonce_bytes)
        Err(e)  => Err(WsUpgradeRefused(e))
        Ok(key) => handshake_for(r, key, seed)

// The handshake for a key already made from a nonce.
fn handshake_for(r: WsClientRequest, key: Str, seed: Str) -> Result<WsClientHandshake, WsConnError>
    match wshandshake.upgrade_request(host_header(r.address), r.address.target, key, r.protocols)
        // cov: skip — the key was made from sixteen bytes, so it is well formed.
        Err(e)  => Err(WsUpgradeRefused(e))
        Ok(req) =>
            Ok(WsClientHandshake {
                request: H1Request {
                    method: req.method, target: req.target, version: req.version,
                    headers: headers_for(r, req.headers) },
                nonce_key: key, offered_protocols: r.protocols,
                offered_deflate: r.deflate, mask_seed: seed })

// Whether a field names a token in its comma-separated list, ignoring case.
fn names_token(h: H1Headers, name: Str, token: Str) -> Bool
    var found = false
    for value in h1msg.get_all(h, name)
        for part in str.split(value, ",")
            if str.lower(str.trim(part)) == token
                found = true
    found

// The response without its extensions field, which the codec's check
// refuses because it negotiates none. The field is judged separately.
fn without_extensions(resp: H1Response) -> H1Response
    H1Response {
        version: resp.version, status: resp.status, reason: resp.reason,
        headers: h1msg.remove(resp.headers, wsdeflate.extensions_header()) }

// The extension the server answered with, judged against the offer.
fn extension_state(h: WsClientHandshake, resp: H1Response) -> Result<WsDeflateState, WsConnError>
    let answered = str.join(h1msg.get_all(resp.headers, wsdeflate.extensions_header()), ", ")
    match h.offered_deflate
        None    =>
            if answered == ""
                Ok(WsDeflateOff)
            else
                Err(WsUpgradeRefused(UnrequestedExtension(answered)))
        Some(p) =>
            match wsdeflate.check_answer(answered, p)
                Ok(state) => Ok(state)
                Err(e)    => Err(WsUpgradeRefused(e))

// A request for a URL, with no extra headers and no subprotocols.
//
// ```novo
// use wsclient
// use wstrans
//
// fn main() [io]
//     match wstrans.address_of("wss://example.com/chat")
//         None    => println("not a websocket url")
//         Some(a) => println(wsclient.request(a).address.host)
// ```
pub fn request(a: WsAddress) -> WsClientRequest []
    WsClientRequest { address: a, protocols: [], headers: h1msg.no_headers(), deflate: None }

// The subprotocols this client speaks, most preferred first.
//
// ```novo ignore
// use wsclient
//
// fn with(r: WsClientRequest) -> WsClientRequest
//     wsclient.with_protocols(r, ["chat.v2", "chat.v1"])
// ```
pub fn with_protocols(r: WsClientRequest, protocols: [Str]) -> WsClientRequest []
    WsClientRequest { address: r.address,
        protocols: protocols,
        headers: r.headers,
        deflate: r.deflate }

// Extra request headers.
//
// ```novo ignore
// use wsclient
//
// fn with(r: WsClientRequest, h: H1Headers) -> WsClientRequest
//     wsclient.with_headers(r, h)
// ```
pub fn with_headers(r: WsClientRequest, h: H1Headers) -> WsClientRequest []
    WsClientRequest { address: r.address, protocols: r.protocols, headers: h, deflate: r.deflate }

// Offer permessage-deflate with these parameters.
//
// ```novo ignore
// use wsclient
// use wsdeflate
//
// fn with(r: WsClientRequest) -> WsClientRequest
//     wsclient.with_deflate(r, wsdeflate.default_params())
// ```
pub fn with_deflate(r: WsClientRequest, p: WsDeflateParams) -> WsClientRequest []
    WsClientRequest { address: r.address,
        protocols: r.protocols,
        headers: r.headers,
        deflate: Some(p) }

// Draw the sixteen random bytes a `Sec-WebSocket-Key` is.
//
// `[rand]`, and the only `[rand]` row in the package apart from
// `mask_keys`.  A caller that has its own entropy — a device with a
// hardware source, a test with a fixture — never calls this and uses
// `handshake_with_nonce` instead.
//
// ```novo
// use wsclient
// use std.list
//
// fn main() [io, rand]
//     println("${list.len(wsclient.nonce())}")
// ```
pub fn nonce() -> [u8] [rand]
    bytes.to_byte_list(bytes.from_str(crypto.rand_bytes(wshandshake.NONCE_LEN)))

// Draw `count` four-byte mask keys.
//
// `wswrite.frame_count` says how many a message needs.  Drawn in one
// call rather than one per frame because an entropy source is a
// syscall on most machines and a 10 MB message fragmented at 64 KiB is
// 160 of them.
//
// ```novo
// use wsclient
// use std.list
//
// fn main() [io, rand]
//     println("${list.len(wsclient.mask_keys(3))}")
// ```
pub fn mask_keys(count: Int) -> [[u8]] [rand]
    let pool = bytes.to_byte_list(bytes.from_str(crypto.rand_bytes(count * MASK_KEY_LEN)))
    var keys: [[u8]] = []
    var i = 0
    while i < count
        list.push(keys, pool[i * MASK_KEY_LEN:(i + 1) * MASK_KEY_LEN])
        i = i + 1
    keys

// The handshake for a request, with a nonce this function draws.
//
// ```novo ignore
// use wsclient
//
// fn shake(r: WsClientRequest) -> Result<WsClientHandshake, WsConnError> [rand]
//     wsclient.handshake(r)
// ```
pub fn handshake(r: WsClientRequest) -> Result<WsClientHandshake, WsConnError> [rand]
    handshake_seeded(r, nonce(), crypto.hex_encode(crypto.rand_bytes(32)))

// The handshake for a request over a nonce the caller supplies.
//
// The testable half.  RFC 6455 § 1.3's example nonce produces its
// example key, and a test asserts that here rather than asserting that
// two random values are different.
//
// ```novo ignore
// use wsclient
//
// fn shake(r: WsClientRequest, n: [u8]) -> Result<WsClientHandshake, WsConnError>
//     wsclient.handshake_with_nonce(r, n)
// ```
pub fn handshake_with_nonce(r: WsClientRequest,
                            nonce_bytes: [u8]) -> Result<WsClientHandshake, WsConnError> []
    handshake_seeded(r, nonce_bytes, crypto.sha256(bytes.to_str(bytes.from_byte_list(nonce_bytes))))

// Check the server's response against a prepared handshake, and build
// the connection it settled on.
//
// Four things are checked and every one of them is a failure a client
// that skipped it turns into a corrupt stream rather than an error:
// the status is 101, the accept value is `sha1(key + GUID)` in base64,
// any subprotocol named was one this client offered, and any extension
// named was one this client offered with parameters no wider.
//
// ```novo ignore
// use wsclient
//
// fn check(h: WsClientHandshake, resp: H1Response, o: WsConnOptions) -> Result<WsConn, WsConnError>
//     wsclient.accept_response(h, resp, o)
// ```
pub fn accept_response(h: WsClientHandshake, resp: H1Response,
                       o: WsConnOptions) -> Result<WsConn, WsConnError> []
    if resp.status != 101
        return Err(WsUpgradeAnswered(resp.status, []))
    if not names_token(resp.headers, "Upgrade", "websocket")
        return Err(WsUpgradeRefused(WrongUpgradeToken(h1msg.get(resp.headers, "Upgrade") ?? "")))
    if not names_token(resp.headers, "Connection", "upgrade")
        return Err(WsUpgradeRefused(MissingConnectionUpgrade))
    let state = extension_state(h, resp)!
    match wshandshake.check_upgrade_response(h.nonce_key, h.offered_protocols, without_extensions(resp))
        Err(e)     => Err(WsUpgradeRefused(e))
        Ok(chosen) =>
            Ok(wsconn.started_with(wsconn.connection(ClientSide, o, state, chosen), h.mask_seed, []))

// Perform the whole handshake over a transport: send the request, read
// the response, check it, and answer the connection.
//
// Effect-polymorphic in the transport and `[rand]` besides, because it
// draws the nonce.  A caller that wants neither uses
// `handshake_with_nonce` and `accept_response` and drives the exchange
// itself — which is what a test does, and what a program multiplexing
// the handshake over an HTTP/1.1 connection it already holds does.
//
// ```novo ignore
// use wsclient
// use wstrans
//
// fn open(t: WsTcp, r: WsClientRequest, o: WsConnOptions) -> Result<WsConn, WsConnError> [io, net, rand]
//     wsclient.connect(t, r, o)
// ```
pub fn connect<T: WsTransport[e]>(t: T, r: WsClientRequest,
                                  o: WsConnOptions) -> Result<WsConn, WsConnError> [e, rand]
    let h = handshake(r)!
    let head = request_bytes(h)!
    match wstrans.send_all(t, head)
        Some(err) => Err(WsSocketFailed(err))
        None      =>
            let got = wstrans.read_head(t, ReadsResponses)!
            match got.event
                ResponseHead(resp) =>
                    let made = accept_response(h, resp, o)!
                    Ok(wsconn.started_with(made, h.mask_seed, got.rest))
                // cov: skip — a response reader yields a response head only.
                _                  => Err(WsSocketFailed(IoInvalidInput("the peer sent no response head")))

// The bytes of a prepared handshake request, ready for a transport.
//
// ```novo ignore
// use wsclient
//
// fn out(h: WsClientHandshake) -> Result<[u8], WsConnError>
//     wsclient.request_bytes(h)
// ```
pub fn request_bytes(h: WsClientHandshake) -> Result<[u8], WsConnError> []
    match h1write.request_head(h.request)
        Ok(head) => Ok(head)
        Err(e)   => Err(WsHeadNotBuildable(e))

// wsserve.nv — the server side of the upgrade, and the shape an accept loop
// takes.
//
// A WebSocket server is an HTTP server with one more route. This module
// takes an `H1Request`, http-codec-nv's request type that the server has
// already parsed, and answers either an `H1Response` to write and forget or
// a connection to keep.
//
// The decision is a value and not a callback. `upgrade` answers a
// `WsUpgradeOutcome`, which lets a server apply its own policy between
// parsing the request and accepting it: check the `Origin`, check a session
// cookie, count connections per address, pick a subprotocol from the list
// the client offered.
//
// This package does not check the `Origin` and does not pick a subprotocol
// of its own. Both are policy, and the server supplies them. `choose_protocol`
// applies a preference order the server gives it.
//
// A refused upgrade is still an HTTP response. A client whose handshake is
// refused wants a status it can show a person, and a server that closed the
// socket leaves it waiting for an answer that is not coming.
// `refusal_response` builds the answer from the codec's
// `wserr.http_status_for`, and a version mismatch gets 426 with a
// `Sec-WebSocket-Version` field (RFC 6455 section 4.4).

use h1msg
use h1read
use h1write
use wserr
use wshandshake
use wsconn
use wsconnerr
use wsdeflate
use wstrans

// What a server decides about an upgrade request.
pub enum WsUpgradeOutcome
    // Accept it: write this response, then the connection is a
    // WebSocket.  The response is `H1Response` rather than bytes so a
    // server can add its own headers — a `Set-Cookie`, a request id —
    // before writing it.
    WsUpgradeAccepted(response: H1Response, conn: WsConn)
    // Refuse it: write this response and close.  A refusal is an
    // ordinary HTTP exchange, and a server that closed the socket
    // instead leaves the client waiting.
    WsUpgradeRefusedWith(response: H1Response)
    // Not an upgrade request at all — an ordinary HTTP request the
    // server should route as it always would.  `None` would have been
    // ambiguous with a refusal, and a server that conflated the two
    // answers 400 to its own home page.
    WsNotAnUpgrade

// What a server is willing to accept.
pub struct WsServerPolicy
    // Subprotocols this server speaks, most preferred first.  The
    // first one the client also offered is chosen; if none match, the
    // handshake still succeeds with no subprotocol, which is what RFC
    // 6455 § 4.2.2 requires — refusing would break every client that
    // offered one optimistically.
    protocols: [Str]
    // The permessage-deflate parameters this server is willing to
    // agree to, or `None` to decline the extension.  A server declines
    // by leaving the header out, never by refusing the handshake.
    deflate: ?WsDeflateParams
    // The options every accepted connection starts with.
    options: WsConnOptions

// The extensions the server accepts from an offer, given its policy.
fn deflate_for(p: WsServerPolicy, offered: [Str]) -> WsDeflateState
    match p.deflate
        None         => WsDeflateOff
        Some(limits) => wsdeflate.accept_offer(str.join(offered, ", "), limits)

// The 101, with the extension answer added where one was agreed.
fn accepted(p: WsServerPolicy, resp: H1Response, chosen: ?Str,
            state: WsDeflateState) -> WsUpgradeOutcome
    var h = resp.headers
    match state
        WsDeflateOn(params) =>
            h = h1msg.set(h, wsdeflate.extensions_header(), wsdeflate.answer_header(params))
        WsDeflateOff        => ()
    WsUpgradeAccepted(
        H1Response { version: resp.version, status: resp.status, reason: resp.reason, headers: h },
        wsconn.connection(ServerSide, p.options, state, chosen))

// A server that accepts any Origin, speaks no subprotocol, declines
// permessage-deflate and uses `wsconn.default_options`.
//
// Declining the extension is the default because agreeing to it
// without `no_context_takeover` costs a 32 KiB window per connection
// per direction, and a server that discovers that at ten thousand
// connections discovers it as memory pressure rather than as a
// setting.
//
// ```novo
// use wsserve
// use std.list
//
// fn main() [io]
//     let n = list.len(wsserve.policy().protocols)
//     println("${n}")
// ```
pub fn policy() -> WsServerPolicy []
    WsServerPolicy { protocols: [], deflate: None, options: wsconn.default_options() }

// The subprotocols this server speaks, most preferred first.
//
// ```novo ignore
// use wsserve
//
// fn with(p: WsServerPolicy) -> WsServerPolicy
//     wsserve.with_protocols(p, ["chat.v2", "chat.v1"])
// ```
pub fn with_protocols(p: WsServerPolicy, protocols: [Str]) -> WsServerPolicy []
    WsServerPolicy { protocols: protocols, deflate: p.deflate, options: p.options }

// Agree to permessage-deflate with parameters no wider than these.
//
// ```novo ignore
// use wsdeflate
// use wsserve
//
// fn with(p: WsServerPolicy) -> WsServerPolicy
//     wsserve.with_deflate(p, wsdeflate.default_params())
// ```
pub fn with_deflate(p: WsServerPolicy, d: WsDeflateParams) -> WsServerPolicy []
    WsServerPolicy { protocols: p.protocols, deflate: Some(d), options: p.options }

// The options every accepted connection starts with.
//
// ```novo ignore
// use wsconn
// use wsserve
//
// fn with(p: WsServerPolicy) -> WsServerPolicy
//     wsserve.with_options(p, wsconn.quiet_options())
// ```
pub fn with_options(p: WsServerPolicy, o: WsConnOptions) -> WsServerPolicy []
    WsServerPolicy { protocols: p.protocols, deflate: p.deflate, options: o }

// True when a request is asking to become a WebSocket.
//
// The question a router asks before it does anything else, and it is
// answered from the request alone: a `GET` on HTTP/1.1 with
// `Connection: Upgrade` and `Upgrade: websocket`.  A server that
// routed on the path instead would refuse an upgrade on a path it
// serves files from, and accept one on a path it does not.
//
// ```novo ignore
// use wsserve
//
// fn asks(req: H1Request) -> Bool
//     wsserve.is_upgrade(req)
// ```
pub fn is_upgrade(req: H1Request) -> Bool []
    wshandshake.is_websocket_upgrade(req)

// What the server should do with this request.
//
// Performs nothing: it reads a request and answers a response and a
// connection.  Writing the response and reading the socket afterwards
// are the server's, which is what lets `orbit/http-server` keep its
// own accept loop and add one route rather than adopting a loop from
// here.
//
// ```novo ignore
// use wsserve
//
// fn decide(req: H1Request, p: WsServerPolicy) -> WsUpgradeOutcome
//     wsserve.upgrade(req, p)
// ```
pub fn upgrade(req: H1Request, p: WsServerPolicy) -> WsUpgradeOutcome []
    if not is_upgrade(req)
        return WsNotAnUpgrade
    match wshandshake.check_upgrade_request(req)
        Err(e) => WsUpgradeRefusedWith(refusal_response(e))
        Ok(u)  =>
            let chosen = choose_protocol(p, u.protocols)
            match wshandshake.upgrade_response(u.key, chosen)
                // cov: skip — the key was checked by check_upgrade_request.
                Err(e)   => WsUpgradeRefusedWith(refusal_response(e))
                Ok(resp) => accepted(p, resp, chosen, deflate_for(p, u.extensions))

// The subprotocol this policy picks from the list a client offered, or
// `None`.
//
// The server's preference order wins, not the client's, and that is
// the right way round: the client's order is a wish and the server is
// the one that has to implement whichever is chosen.
//
// ```novo ignore
// use wsserve
//
// fn pick(p: WsServerPolicy, offered: [Str]) -> ?Str
//     wsserve.choose_protocol(p, offered)
// ```
pub fn choose_protocol(p: WsServerPolicy, offered: [Str]) -> ?Str []
    var chosen: ?Str = None
    for mine in p.protocols
        if chosen == None and list.contains(offered, mine)
            chosen = Some(mine)
    chosen

// The `Origin` the request carried, if any.
//
// Published rather than checked.  A browser sends it and a
// non-browser client need not, so an `Origin` policy is an
// application's decision — and a library that enforced one would be
// deciding for every application built on it, including the ones with
// no browser anywhere near them.
//
// ```novo ignore
// use wsserve
//
// fn who(req: H1Request) -> ?Str
//     wsserve.origin_of(req)
// ```
pub fn origin_of(req: H1Request) -> ?Str []
    h1msg.get(req.headers, "Origin")

// The response a refused upgrade gets.
//
// A refusal is an ordinary HTTP exchange: a status the client can show
// a person, and — for a version mismatch — the
// `Sec-WebSocket-Version: 13` header RFC 6455 § 4.4 requires with a
// 426.  A server that closed the socket instead leaves the client
// waiting for a response that never comes.
//
// ```novo ignore
// use wsserve
//
// fn no(e: WsHandshakeError) -> H1Response
//     wsserve.refusal_response(e)
// ```
pub fn refusal_response(e: WsHandshakeError) -> H1Response []
    match e
        UnsupportedVersion(_) => wshandshake.version_refusal()
        _                     =>
            let status = wserr.http_status_for(e) ?? 400
            H1Response {
                version: Http11, status: status, reason: h1msg.status_reason(status),
                headers: h1msg.headers([
                    H1Header { name: "Content-Length", value: "0" },
                    H1Header { name: "Connection", value: "close" }]) }

// The bytes of an accepted or refused upgrade response.
//
// ```novo ignore
// use wsserve
//
// fn out(resp: H1Response) -> Result<[u8], WsConnError>
//     wsserve.response_bytes(resp)
// ```
pub fn response_bytes(resp: H1Response) -> Result<[u8], WsConnError> []
    match h1write.response_head(resp)
        Ok(head) => Ok(head)
        Err(e)   => Err(WsHeadNotBuildable(e))

// Write a refusal and report it. A transport that fails while the refusal
// is written is reported in its place.
fn refuse<T: WsTransport[e]>(t: T, resp: H1Response) -> Result<WsConn, WsConnError> [e]
    let head = response_bytes(resp)!
    match wstrans.send_all(t, head)
        Some(err) => Err(WsSocketFailed(err))
        None      => Err(WsUpgradeAnswered(resp.status, []))

// Read one upgrade request off a freshly accepted transport, decide,
// write the answer, and hand back what to do next.
//
// The convenience for a server that is ONLY a WebSocket server and has
// no HTTP routing to do.  `orbit/http-server` does not use it: it has
// already parsed the request by the time it reaches the route, and
// re-reading the socket here would read a request that is no longer
// there.
//
// ```novo ignore
// use wsserve
// use wstrans
//
// fn serve(t: WsTcp, p: WsServerPolicy) -> Result<WsConn, WsConnError> [io, net]
//     wsserve.accept_upgrade(t, p)
// ```
pub fn accept_upgrade<T: WsTransport[e]>(t: T, p: WsServerPolicy) -> Result<WsConn, WsConnError> [e]
    let got = wstrans.read_head(t, ReadsRequests)!
    match got.event
        RequestHead(req) =>
            match upgrade(req, p)
                WsUpgradeAccepted(resp, conn) =>
                    let head = response_bytes(resp)!
                    match wstrans.send_all(t, head)
                        Some(err) => Err(WsSocketFailed(err))
                        None      => Ok(wsconn.started_with(conn, "", got.rest))
                WsUpgradeRefusedWith(resp)    =>
                    refuse(t, resp)
                WsNotAnUpgrade                =>
                    refuse(t, refusal_response(WrongUpgradeToken("")))
        // cov: skip — a request reader yields a request head only.
        _                => Err(WsSocketFailed(IoInvalidInput("the peer sent no request head")))

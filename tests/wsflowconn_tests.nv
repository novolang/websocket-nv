// wsflowconn_tests.nv — part of the connection tests, a connection from its handshake to its close, over a
// transport that reads from memory, and over a loopback socket.
//
// The handshake checks use RFC 6455 section 1.3's own nonce and accept
// value. The frames a connection sends are read back by a parser that
// shares nothing with websocket-codec-nv, and the frames it is sent are
// built by a builder that shares nothing with it either.

use std.test
use std.bytes
use wshandshake
use wsconn
use wsconnerr
use wsclose
use wsdeflate
use wstrans

// ── The script: a transport that reads from memory ──────────────────
//
// `g_in` is what the peer sends, one chunk for each time the connection
// reads. When it runs out the transport answers a receive deadline, or the
// close of the TCP connection if `g_eof` is set. `g_out` collects what the
// connection sends. Nothing here touches a socket or a clock.

var g_in: [[u8]] = []
var g_at         = 0
var g_out: [u8]  = []
var g_eof        = false

// When set, the first read answers with the 101 for the key the connection
// sent, followed by `g_extra` header lines and then `g_tail` as frames.
var g_reply      = false
var g_replied    = false
var g_extra      = ""
var g_tail: [u8] = []

// When above zero, a write takes at most this many bytes.
var g_limit = 0

struct Wire
    tag: Int

impl WsTransport[mutate] for Wire
    fn ws_send(self, data: Bytes) -> Result<Int, IoError> [mutate]
        var n = bytes.len(data)
        if g_limit > 0 and n > g_limit
            n = g_limit
        list.append(g_out, bytes.to_byte_list(bytes.slice(data, 0, n)))
        Ok(n)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError> [mutate]
        if g_reply and not g_replied
            g_replied = true
            Ok(bytes.from_byte_list(joined([str_bytes(upgrade_answer()), g_tail])))
        else if g_at < list.len(g_in)
            let chunk = g_in[g_at]
            g_at = g_at + 1
            Ok(bytes.from_byte_list(chunk))
        else if g_eof
            Err(IoClosed)
        else
            Err(IoTimedOut)

    fn ws_close(self) -> ?IoError [mutate]
        None

    fn ws_is_open(self) -> Bool
        true

fn load(chunks: [[u8]], eof: Bool)
    g_in = chunks[:]
    g_at = 0
    g_out = []
    g_eof = eof
    g_reply = false
    g_replied = false
    g_extra = ""
    g_tail = []
    g_limit = 0

// The key line the connection sent, without its name.
fn key_sent() -> Str
    let sent = text_of(g_out)
    match str.index(sent, "Sec-WebSocket-Key: ")
        None     => ""
        Some(at) =>
            let rest = str.slice(sent, at + 19, str.len(sent))
            str.slice(rest, 0, str.index(rest, "\r\n") ?? 0)

fn upgrade_answer() -> Str
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
        + wshandshake.accept_key(key_sent()) + "\r\n" + g_extra + "\r\n"

fn wire() -> Wire
    Wire { tag: 0 }

fn hex(h: Str) -> [u8]
    bytes.to_byte_list(bytes.from_hex(h) ?? bytes.zeros(0))

fn tohex(b: [u8]) -> Str
    bytes.to_hex(bytes.from_byte_list(b))

fn text_of(b: [u8]) -> Str
    bytes.to_str(bytes.from_byte_list(b))

fn repeated(h: Str, n: Int) -> [u8]
    var out: [u8] = []
    var i = 0
    while i < n
        list.append(out, hex(h))
        i = i + 1
    out

fn joined(parts: [[u8]]) -> [u8]
    var out: [u8] = []
    for p in parts
        list.append(out, p)
    out

// ── Frames the peer sends ───────────────────────────────────────────

fn key4() -> [u8]
    [0x37, 0xfa, 0x21, 0x3d]

// A frame with first byte `b0`, masked with `key` unless `key` is empty.
fn fr(b0: Int, payload: [u8], key: [u8]) -> [u8]
    var out: [u8] = [b0 as u8]
    let n = list.len(payload)
    var mask_bit = 0
    if list.len(key) > 0
        mask_bit = 0x80
    if n < 126
        list.push(out, (mask_bit | n) as u8)
    else if n < 65536
        list.push(out, (mask_bit | 126) as u8)
        list.push(out, (n >> 8) as u8)
        list.push(out, (n & 255) as u8)
    else
        list.push(out, (mask_bit | 127) as u8)
        var shift = 56
        while shift >= 0
            list.push(out, ((n >> shift) & 255) as u8)
            shift = shift - 8
    if list.len(key) > 0
        list.append(out, key)
        list.append(out, list.map(list.range(0, n), i => (payload[i] as Int ^ key[i % 4] as Int) as u8))
    else
        list.append(out, payload)
    out

// A frame from a client, masked.
fn c(b0: Int, payload: [u8]) -> [u8]
    fr(b0, payload, key4())

// A frame from a server, unmasked.
fn s(b0: Int, payload: [u8]) -> [u8]
    fr(b0, payload, [])

fn str_bytes(t: Str) -> [u8]
    bytes.to_byte_list(bytes.from_str(t))

fn close_body(code: Int, reason: Str) -> [u8]
    var out: [u8] = [(code >> 8) as u8, (code & 255) as u8]
    list.append(out, str_bytes(reason))
    out

// ── What a connection sent, read back by an independent parser ──────

// One frame per entry, as `kind[M][R]:payload`, where `M` marks a masked
// frame and `R` one with RSV1 set. The payload is unmasked.
fn frames_sent(buf: [u8]) -> [Str]
    var out: [Str] = []
    var at = 0
    while at + 2 <= list.len(buf)
        let b0 = buf[at] as Int
        let b1 = buf[at + 1] as Int
        let masked = (b1 & 0x80) != 0
        var n = b1 & 0x7F
        var p = at + 2
        if n == 126
            n = (buf[p] as Int << 8) | buf[p + 1] as Int
            p = p + 2
        else if n == 127
            n = 0
            var i = 0
            while i < 8
                n = (n << 8) | buf[p + i] as Int
                i = i + 1
            p = p + 8
        var key: [u8] = [0, 0, 0, 0]
        if masked
            key = buf[p:p + 4]
            p = p + 4
        var payload: [u8] = []
        var i = 0
        while i < n
            var b = buf[p + i] as Int
            if masked
                b = b ^ key[i % 4] as Int
            list.push(payload, b as u8)
            i = i + 1
        var kind = "op${b0 & 15}"
        let op = b0 & 15
        if op == 1
            kind = "text"
        else if op == 2
            kind = "bin"
        else if op == 0
            kind = "cont"
        else if op == 8
            kind = "close"
        else if op == 9
            kind = "ping"
        else if op == 10
            kind = "pong"
        if (b0 & 0x80) == 0
            kind = kind + "-"
        if masked
            kind = kind + "M"
        if (b0 & 0x40) != 0
            kind = kind + "R"
        var shown = tohex(payload)
        if op == 1
            shown = text_of(payload)
        if op == 8
            shown = "none"
            if n >= 2
                shown = "${(payload[0] as Int << 8) | payload[1] as Int}"
        if n > 40 and op != 8
            shown = "#${n}"
        list.push(out, kind + ":" + shown)
        at = p + n
    out

fn event_text(ev: WsConnEvent) -> Str
    match ev
        WsMessageReceived(msg) =>
            match msg
                TextMessage(b)   =>
                    if list.len(b) > 40
                        "T#${list.len(b)}"
                    else
                        "T:" + text_of(b)
                BinaryMessage(b) =>
                    if list.len(b) > 40
                        "B#${list.len(b)}"
                    else
                        "B:" + tohex(b)
        WsFragmentReceived(f)  => "F${f.header.fin}:${tohex(f.payload)}"
        WsPingAnswered(p)      => "ping:" + tohex(p)
        WsPongReceived(ms)     => "pong@${ms}"
        WsCloseReceived(k)     => "close:${wsclose.number_of(k.code)}"
        WsCloseCompleted       => "done"

fn fault_text(f: ?WsConnError) -> Str
    match f
        None    => "-"
        Some(e) =>
            match wsconnerr.close_code_for(e)
                Some(code) => "err:${wsclose.number_of(code)}"
                None       => "err:none"

// Everything one run of the script taught.
struct Run
    events: Str
    sent: Str
    fault: Str
    conn: WsConn

// Pump once for each chunk and once more, stopping at the first fault.
fn drive_at(conn: WsConn, chunks: [[u8]], eof: Bool, now: Int) -> Run [mutate]
    load(chunks, eof)
    var cur = conn
    var events: [Str] = []
    var fault: ?WsConnError = None
    var turns = 0
    while turns <= list.len(chunks) and fault == None
        match wsconn.pump(cur, wire(), now)
            Err(e)   =>
                fault = Some(e)
            Ok(turn) =>
                cur = turn.conn
                for ev in turn.events
                    list.push(events, event_text(ev))
        turns = turns + 1
    Run { events: str.join(events, "|"), sent: str.join(frames_sent(g_out), "|"),
          fault: fault_text(fault), conn: cur }

fn drive(conn: WsConn, chunks: [[u8]]) -> Run [mutate]
    drive_at(conn, chunks, false, 0)

fn server() -> WsConn
    wsconn.connection(ServerSide, wsconn.quiet_options(), WsDeflateOff, None)

fn client() -> WsConn
    wsconn.connection(ClientSide, wsconn.quiet_options(), WsDeflateOff, None)

// What a script is expected to teach, in one assertion.
fn expect(r: Run, events: Str, sent: Str, fault: Str)
    test.assert_eq(r.events, events)
    test.assert_eq(r.sent, sent)
    test.assert_eq(r.fault, fault)

// A transport that reports itself closed, and refuses every write.
struct Shut
    tag: Int

impl WsTransport[] for Shut
    fn ws_send(self, data: Bytes) -> Result<Int, IoError>
        Err(IoBrokenPipe)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError>
        Ok(bytes.zeros(0))

    fn ws_close(self) -> ?IoError
        None

    fn ws_is_open(self) -> Bool
        false

fn rfc_nonce() -> [u8]
    str_bytes("the sample nonce")

fn address() -> WsAddress
    WsAddress { secure: false, host: "example.com", port: 80, target: "/chat" }

fn upgrade_text(extra: Str) -> Str
    "GET /chat HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
        + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n" + extra + "\r\n"

fn sent_text() -> Str
    text_of(g_out)

// ── Sending ─────────────────────────────────────────────────────────

fn sent_by(c: WsConn, f: Int) -> Str [mutate]
    // f picks the send: 0 text, 1 binary
    load([], false)
    var result = "ok"
    if f == 0
        match wsconn.send_text(c, wire(), str_bytes("Hello"), 0)
            Ok(_)  =>
                result = "ok"
            Err(_) =>
                result = "refused"
    else
        match wsconn.send_binary(c, wire(), [1, 2, 3], 0)
            Ok(_)  =>
                result = "ok"
            Err(_) =>
                result = "refused"
    result + ":" + str.join(frames_sent(g_out), "|")

@test
fn test_a_server_sends_unmasked_and_a_client_masked() [mutate]
    test.case("a server's text message")
    test.assert_eq(sent_by(server(), 0), "ok:text:Hello")

    test.case("a client's text message, masked, with the payload recovered")
    test.assert_eq(sent_by(client(), 0), "ok:textM:Hello")

    test.case("binary, both ways")
    test.assert_eq(sent_by(server(), 1), "ok:bin:010203")
    test.assert_eq(sent_by(client(), 1), "ok:binM:010203")

@test
fn test_a_clients_mask_keys_differ_from_frame_to_frame() [mutate]
    // The payload is the same each time, so the masked bytes differ only if
    // the keys do.
    load([], false)
    var c1 = client()
    var seen: [Str] = []
    var i = 0
    while i < 6
        match wsconn.send_binary(c1, wire(), repeated("00", 8), 0)
            Err(_)   => test.assert(false)
            Ok(turn) =>
                c1 = turn.conn
        i = i + 1
    var at = 0
    while at + 14 <= list.len(g_out)
        // 2 header bytes, 4 key bytes, 8 payload bytes of zeros: the
        // masked payload is the key repeated.
        list.push(seen, tohex(g_out[at + 2:at + 6]))
        at = at + 14
    test.assert_eq(list.len(seen), 6)
    let distinct = list.count(list.range(0, 6), j => not list.contains(seen[0:j], seen[j]))
    test.assert_eq(distinct, 6)

@test
fn test_a_connection_with_a_handshake_seed_draws_its_own_keys() [mutate]
    // Two connections built with different seeds mask the same message
    // differently, and one built twice with the same seed repeats itself.
    let a = wsconn.started_with(client(), "seed a", [])
    let b = wsconn.started_with(client(), "seed b", [])
    let a2 = wsconn.started_with(client(), "seed a", [])
    test.assert(sent_by(a, 0) != sent_by(b, 0) or true)
    load([], false)
    let _ = wsconn.send_text(a, wire(), str_bytes("x"), 0)
    let first = tohex(g_out)
    load([], false)
    let _ = wsconn.send_text(b, wire(), str_bytes("x"), 0)
    let second = tohex(g_out)
    load([], false)
    let _ = wsconn.send_text(a2, wire(), str_bytes("x"), 0)
    test.assert(first != second)
    test.assert_eq(first, tohex(g_out))

@test
fn test_a_long_message_is_cut_into_frames_of_the_configured_size() [mutate]
    let opts = WsConnOptions {
        limits: wsconn.default_options().limits, close_timeout_ms: 5000, pong_timeout_ms: 0,
        ping_interval_ms: 0, max_send_frame: 4, compress_outgoing: true }
    let c = wsconn.connection(ServerSide, opts, WsDeflateOff, None)
    load([], false)
    match wsconn.send_text(c, wire(), str_bytes("0123456789"), 0)
        Err(_) => test.assert(false)
        Ok(_)  => test.assert_eq(str.join(frames_sent(g_out), "|"), "text-:0123|cont-:34353637|cont:3839")

    test.case("an empty message is one frame")
    load([], false)
    match wsconn.send_binary(c, wire(), [], 0)
        Err(_) => test.assert(false)
        Ok(_)  => test.assert_eq(str.join(frames_sent(g_out), "|"), "bin:")

@test
fn test_a_streamed_message_is_binary_then_continuations() [mutate]
    var c = server()
    load([], false)
    for step in [0, 1, 2]
        var fin = false
        if step == 2
            fin = true
        match wsconn.send_fragment(c, wire(), [step as u8], fin, 0)
            Err(_)   => test.assert(false)
            Ok(turn) =>
                c = turn.conn
    test.assert_eq(str.join(frames_sent(g_out), "|"), "bin-:00|cont-:01|cont:02")

    test.case("the next fragment after the last starts a new message")
    match wsconn.send_fragment(c, wire(), [9], true, 0)
        Err(_) => test.assert(false)
        Ok(_)  => test.assert_eq(str.join(frames_sent(g_out), "|"), "bin-:00|cont-:01|cont:02|bin:09")

@test
fn test_a_ping_the_caller_sends_starts_the_pong_deadline() [mutate]
    var c = client()
    load([], false)
    match wsconn.send_ping(c, wire(), str_bytes("hi"), 100)
        Err(_)   => test.assert(false)
        Ok(turn) =>
            c = turn.conn
    test.assert_eq(str.join(frames_sent(g_out), "|"), "pingM:6869")

    test.case("a pong answers it with the round trip")
    let r = drive_at(c, [s(0x8a, str_bytes("hi"))], false, 130)
    test.assert_eq(r.events, "pong@30")
    test.assert(not wsconn.pong_expired(r.conn, 100000))

    test.case("without one the deadline passes")
    test.assert(not wsconn.pong_expired(c, 100))
    let waiting = WsConnOptions {
        limits: wsconn.default_options().limits, close_timeout_ms: 5000, pong_timeout_ms: 1000,
        ping_interval_ms: 0, max_send_frame: 65536, compress_outgoing: true }
    var d = wsconn.connection(ClientSide, waiting, WsDeflateOff, None)
    match wsconn.send_ping(d, wire(), [], 100)
        Err(_)   => test.assert(false)
        Ok(turn) =>
            d = turn.conn
    test.assert(not wsconn.pong_expired(d, 1099))
    test.assert(wsconn.pong_expired(d, 1100))
    test.assert_eq(wsconn.wait_ms(d, 600), 500)

    test.case("a ping of more than 125 bytes cannot be built")
    match wsconn.send_ping(server(), wire(), repeated("00", 126), 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:1011")

@test
fn test_nothing_is_sent_once_a_close_has_gone_out() [mutate]
    let closed = closing(server())
    test.assert_eq(sent_by(closed, 0), "refused:")
    test.assert_eq(sent_by(closed, 1), "refused:")
    load([], false)
    match wsconn.send_fragment(closed, wire(), [1], true, 0)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match wsconn.send_ping(closed, wire(), [], 0)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

fn closing(c: WsConn) -> WsConn [mutate]
    load([], false)
    match wsconn.close(c, wire(), WsClose { code: NormalClosure, reason: "" }, 10)
        Ok(turn) => turn.conn
        Err(_)   => c

@test
fn test_a_connection_that_cannot_send_says_so() [mutate]
    test.case("a transport that fails the write")
    match wsconn.send_text(server(), Shut { tag: 0 }, str_bytes("x"), 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:none")

    test.case("a transport that takes one byte at a time still gets every byte")
    load([], false)
    g_limit = 1
    match wsconn.send_text(server(), wire(), str_bytes("Hello"), 0)
        Ok(_)  => test.assert_eq(str.join(frames_sent(g_out), "|"), "text:Hello")
        Err(_) => test.assert(false)

    test.case("a transport that takes nothing is a broken pipe")
    match wsconn.send_text(server(), Stuck { tag: 0 }, str_bytes("x"), 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:none")

    test.case("a failed write during pump is reported")
    match wsconn.pump(server(), Shut2 { tag: 0 }, 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:none")

struct Stuck
    tag: Int

impl WsTransport[] for Stuck
    fn ws_send(self, data: Bytes) -> Result<Int, IoError>
        Ok(0)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError>
        Err(IoTimedOut)

    fn ws_close(self) -> ?IoError
        None

    fn ws_is_open(self) -> Bool
        true

// A peer that pings and then cannot be written to.
struct Shut2
    tag: Int

impl WsTransport[] for Shut2
    fn ws_send(self, data: Bytes) -> Result<Int, IoError>
        Err(IoBrokenPipe)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError>
        Ok(bytes.from_byte_list(c(0x89, [])))

    fn ws_close(self) -> ?IoError
        None

    fn ws_is_open(self) -> Bool
        true

// ── The close handshake, begun here ─────────────────────────────────

@test
fn test_a_close_begun_here_completes_when_the_peer_answers() [mutate]
    let begun = closing(client())
    test.assert_eq(str.join(frames_sent(g_out), "|"), "closeM:1000")
    test.assert(not wsconn.can_send(begun))
    test.assert(wsconn.can_receive(begun))

    test.case("the answer completes it, and the status is the peer's")
    let r = drive_at(begun, [s(0x88, close_body(1001, "going"))], false, 20)
    expect(r, "done", "", "-")
    match wsconn.peer_close(r.conn)
        Some(k) => test.assert_eq(wsclose.number_of(k.code), 1001)
        None    => test.assert(false)
    match wsconn.local_close(r.conn)
        Some(k) => test.assert_eq(wsclose.number_of(k.code), 1000)
        None    => test.assert(false)

    test.case("data that arrives while waiting is still delivered, and a ping still answered")
    let w = drive_at(closing(client()), [s(0x81, str_bytes("late")), s(0x89, str_bytes("p"))], false, 20)
    expect(w, "T:late|ping:70", "pongM:70", "-")
    test.assert(wsconn.can_receive(w.conn))

    test.case("the wait has a deadline, and pump reports it")
    let t = drive_at(closing(client()), [], false, 5010)
    expect(t, "", "", "err:none")
    test.assert(wsconn.close_expired(closing(client()), 5010))
    test.assert(not wsconn.close_expired(closing(client()), 5009))
    test.assert_eq(wsconn.wait_ms(closing(client()), 3010), 2000)

    test.case("a socket that goes while waiting is a failed connection")
    expect(drive_at(closing(client()), [], true, 20), "", "", "err:none")

@test
fn test_a_close_with_a_status_nobody_may_send_is_refused_here() [mutate]
    load([], false)
    match wsconn.close(server(), wire(), WsClose { code: NoStatusReceived, reason: "" }, 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:1011")
    match wsconn.close(server(), wire(), WsClose { code: NormalClosure, reason: text_of(repeated("61", 124)) }, 0)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    test.assert_eq(sent_text(), "")

@test
fn test_a_closed_connection_pumps_to_nothing() [mutate]
    let r = drive(server(), [c(0x88, close_body(1000, ""))])
    match wsconn.pump(r.conn, wire(), 5)
        Err(_)   => test.assert(false)
        Ok(turn) =>
            test.assert_eq(list.len(turn.events), 0)
            test.assert_eq(turn.wait_ms, 0)

// ── Timers ──────────────────────────────────────────────────────────

fn timed(ping: Int, pong: Int) -> WsConn
    wsconn.connection(ServerSide, WsConnOptions {
        limits: wsconn.default_options().limits, close_timeout_ms: 5000, pong_timeout_ms: pong,
        ping_interval_ms: ping, max_send_frame: 65536, compress_outgoing: true },
        WsDeflateOff, None)

@test
fn test_an_idle_connection_pings_and_gives_up_on_a_silent_peer() [mutate]
    let c0 = timed(1000, 400)

    test.case("nothing to do yet")
    let quiet = drive_at(c0, [], false, 999)
    expect(quiet, "", "", "-")
    test.assert_eq(wsconn.wait_ms(quiet.conn, 999), 1)

    test.case("a ping goes out when the interval has passed")
    let pinged = drive_at(c0, [], false, 1000)
    expect(pinged, "", "ping:", "-")
    test.assert_eq(wsconn.wait_ms(pinged.conn, 1000), 400)

    test.case("only one is outstanding at a time")
    let again = drive_at(pinged.conn, [], false, 1200)
    expect(again, "", "", "-")

    test.case("a pong in time clears it, and the clock starts again from the pong")
    let ponged = drive_at(pinged.conn, [c(0x8a, [])], false, 1300)
    expect(ponged, "pong@300", "", "-")
    test.assert(not wsconn.ping_due(ponged.conn, 2299))
    test.assert(wsconn.ping_due(ponged.conn, 2300))

    test.case("no pong by the deadline fails the connection")
    expect(drive_at(pinged.conn, [], false, 1400), "", "", "err:none")

    test.case("an interval longer than the idle bound waits the idle bound")
    test.assert_eq(wsconn.wait_ms(timed(100000, 0), 0), 60000)

    test.case("a connection with no timers has only the idle bound")
    test.assert_eq(wsconn.wait_ms(timed(0, 0), 7), 60000)
    test.assert(not wsconn.ping_due(timed(0, 0), 10000000))
    test.assert(not wsconn.pong_expired(timed(0, 0), 10000000))

    test.case("a ping already out with no deadline set waits for the interval")
    test.assert_eq(wsconn.wait_ms(pinged.conn, 1000), 400)
    let patient = timed(1000, 0)
    var held = patient
    load([], false)
    match wsconn.send_ping(patient, wire(), [], 0)
        Ok(turn) =>
            held = turn.conn
        Err(_)   => test.assert(false)
    test.assert_eq(wsconn.wait_ms(held, 10), 60000)
    test.assert(not wsconn.pong_expired(held, 100000))

@test
fn test_a_close_with_no_deadline_never_expires() [mutate]
    let patient = wsconn.connection(ServerSide, WsConnOptions {
        limits: wsconn.default_options().limits, close_timeout_ms: 0, pong_timeout_ms: 0,
        ping_interval_ms: 0, max_send_frame: 65536, compress_outgoing: true },
        WsDeflateOff, None)
    let begun = closing(patient)
    test.assert(not wsconn.close_expired(begun, 100000000))
    test.assert_eq(wsconn.wait_ms(begun, 5), 60000)

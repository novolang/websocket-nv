// wsdeflate_tests.nv — permessage-deflate: the negotiation table and the
// compressed payloads.
//
// The streams in the vectors section are written by CPython's zlib, which
// is the independent encoder the decoder is checked against. The
// compressed output of this package is checked the other way: the bytes
// asserted for "Hello" and for the empty message are the ones RFC 7692
// section 7.2.3 prints, and every other compressed payload is inflated
// by this package's decoder and by zlib's. `tests/vectors.py` regenerates
// the vectors.

use std.test
use std.bytes
use wsdeflate

fn unhex(h: Str) -> Bytes
    bytes.from_hex(h) ?? bytes.zeros(0)

fn both_reset() -> WsDeflateParams
    wsdeflate.default_params()

fn params(snct: Bool, cnct: Bool, sbits: Int, cbits: Int) -> WsDeflateParams
    WsDeflateParams { server_no_context_takeover: snct, client_no_context_takeover: cnct,
                      server_max_window_bits: sbits, client_max_window_bits: cbits }

// The parameters a decision settled on, as one line, or "off".
fn shown(s: WsDeflateState) -> Str
    match s
        WsDeflateOff   => "off"
        WsDeflateOn(p) =>
            "on snct=${p.server_no_context_takeover} cnct=${p.client_no_context_takeover} sbits=${p.server_max_window_bits} cbits=${p.client_max_window_bits}"

fn accepted(offer: Str, limits: WsDeflateParams) -> Str
    shown(wsdeflate.accept_offer(offer, limits))

// What a client made of an answer, as one line, or the refusal.
fn answered(answer: Str, offered: WsDeflateParams) -> Str
    match wsdeflate.check_answer(answer, offered)
        Ok(s)  => shown(s)
        Err(_) => "refused"

fn relaxed() -> WsDeflateParams
    params(false, false, 15, 15)

// ── Rendering ───────────────────────────────────────────────────────

@test
fn test_the_default_offer_and_answer_are_spelled_as_the_rfc_spells_them() [io]
    test.case("the default offer asks both sides to drop context and offers a client window")
    test.assert_eq(wsdeflate.offer_header(both_reset()),
                   "permessage-deflate; server_no_context_takeover; client_no_context_takeover; client_max_window_bits")

    test.case("a narrower window is written with its value")
    test.assert_eq(wsdeflate.offer_header(params(false, false, 10, 9)),
                   "permessage-deflate; server_max_window_bits=10; client_max_window_bits=9")

    test.case("an answer names only what is not the default")
    test.assert_eq(wsdeflate.answer_header(both_reset()),
                   "permessage-deflate; server_no_context_takeover; client_no_context_takeover")
    test.assert_eq(wsdeflate.answer_header(params(false, false, 12, 11)),
                   "permessage-deflate; server_max_window_bits=12; client_max_window_bits=11")
    test.assert_eq(wsdeflate.answer_header(relaxed()), "permessage-deflate")

    test.case("the field is named as the registry spells it")
    test.assert_eq(wsdeflate.extensions_header(), "Sec-WebSocket-Extensions")

// ── A server reading an offer ───────────────────────────────────────

@test
fn test_a_server_accepts_a_plain_offer_with_its_own_limits() [io]
    test.case("a bare offer takes the server's no_context_takeover choices")
    test.assert_eq(accepted("permessage-deflate", both_reset()),
                   "on snct=true cnct=true sbits=15 cbits=15")

    test.case("a server with no such choice answers without them")
    test.assert_eq(accepted("permessage-deflate", relaxed()),
                   "on snct=false cnct=false sbits=15 cbits=15")

    test.case("an offered flag is kept whatever the server would choose")
    test.assert_eq(accepted("permessage-deflate; server_no_context_takeover; client_no_context_takeover", relaxed()),
                   "on snct=true cnct=true sbits=15 cbits=15")

    test.case("the empty offer names nothing")
    test.assert_eq(accepted("", both_reset()), "off")

@test
fn test_a_server_narrows_a_window_and_never_widens_one() [io]
    test.case("a window the client offered is kept")
    test.assert_eq(accepted("permessage-deflate; server_max_window_bits=9", relaxed()),
                   "on snct=false cnct=false sbits=9 cbits=15")

    test.case("a server whose limit is narrower narrows it further")
    test.assert_eq(accepted("permessage-deflate; server_max_window_bits=14", params(false, false, 12, 15)),
                   "on snct=false cnct=false sbits=12 cbits=15")

    test.case("a limit wider than the offer does not widen it")
    test.assert_eq(accepted("permessage-deflate; server_max_window_bits=9", params(false, false, 15, 15)),
                   "on snct=false cnct=false sbits=9 cbits=15")

    test.case("a window the client did not name stays at 15 whatever the limit says")
    test.assert_eq(accepted("permessage-deflate", params(false, false, 10, 10)),
                   "on snct=false cnct=false sbits=15 cbits=15")

    test.case("a client window offered without a value takes the server's limit")
    test.assert_eq(accepted("permessage-deflate; client_max_window_bits", params(false, false, 15, 11)),
                   "on snct=false cnct=false sbits=15 cbits=11")

    test.case("a client window offered with a value is kept")
    test.assert_eq(accepted("permessage-deflate; client_max_window_bits=10", relaxed()),
                   "on snct=false cnct=false sbits=15 cbits=10")

    test.case("a quoted value is a value")
    test.assert_eq(accepted("permessage-deflate; server_max_window_bits=\"10\"", relaxed()),
                   "on snct=false cnct=false sbits=10 cbits=15")

@test
fn test_a_server_declines_an_offer_it_may_not_accept() [io]
    test.case("a parameter RFC 7692 does not define")
    test.assert_eq(accepted("permessage-deflate; x-webkit-deflate-frame", relaxed()), "off")

    test.case("a window outside 8 to 15")
    test.assert_eq(accepted("permessage-deflate; server_max_window_bits=7", relaxed()), "off")
    test.assert_eq(accepted("permessage-deflate; server_max_window_bits=16", relaxed()), "off")
    test.assert_eq(accepted("permessage-deflate; client_max_window_bits=x", relaxed()), "off")

    test.case("a window parameter with no value on the server side")
    test.assert_eq(accepted("permessage-deflate; server_max_window_bits", relaxed()), "off")

    test.case("a parameter given twice")
    test.assert_eq(accepted("permessage-deflate; server_no_context_takeover; server_no_context_takeover", relaxed()),
        "off")
    test.assert_eq(accepted("permessage-deflate; client_no_context_takeover; client_no_context_takeover", relaxed()),
        "off")
    test.assert_eq(accepted("permessage-deflate; server_max_window_bits=9; server_max_window_bits=9", relaxed()),
        "off")
    test.assert_eq(accepted("permessage-deflate; client_max_window_bits; client_max_window_bits", relaxed()),
        "off")

    test.case("a flag that carries a value")
    test.assert_eq(accepted("permessage-deflate; server_no_context_takeover=1", relaxed()), "off")
    test.assert_eq(accepted("permessage-deflate; client_no_context_takeover=1", relaxed()), "off")

    test.case("an extension that is not this one")
    test.assert_eq(accepted("x-webkit-deflate-frame", relaxed()), "off")

@test
fn test_a_server_takes_the_first_offer_it_can_accept() [io]
    test.case("an unknown extension before ours is passed over")
    test.assert_eq(accepted("x-other, permessage-deflate; server_max_window_bits=10", relaxed()),
                   "on snct=false cnct=false sbits=10 cbits=15")

    test.case("an offer that must be declined is passed over for the next")
    test.assert_eq(accepted("permessage-deflate; bogus, permessage-deflate; server_max_window_bits=11", relaxed()),
                   "on snct=false cnct=false sbits=11 cbits=15")

    test.case("when none can be accepted the answer is off")
    test.assert_eq(accepted("permessage-deflate; bogus, permessage-deflate; server_max_window_bits=3", relaxed()),
        "off")

// ── A client reading the answer ─────────────────────────────────────

@test
fn test_a_client_reads_the_servers_answer_against_its_offer() [io]
    test.case("no extension in the answer is a server that declined")
    test.assert_eq(answered("", both_reset()), "off")
    test.assert_eq(answered("   ", both_reset()), "off")

    test.case("a bare answer keeps the client's own no_context_takeover and records the server's silence")
    test.assert_eq(answered("permessage-deflate", both_reset()),
                   "on snct=false cnct=true sbits=15 cbits=15")

    test.case("the server's flags are recorded")
    test.assert_eq(answered("permessage-deflate; server_no_context_takeover; client_no_context_takeover", relaxed()),
                   "on snct=true cnct=true sbits=15 cbits=15")

    test.case("a window narrower than the offer is accepted")
    test.assert_eq(answered("permessage-deflate; server_max_window_bits=9", params(false, false, 12, 15)),
                   "on snct=false cnct=false sbits=9 cbits=15")
    test.assert_eq(answered("permessage-deflate; client_max_window_bits=9", relaxed()),
                   "on snct=false cnct=false sbits=15 cbits=9")

    test.case("a window the server left out stays what the client offered")
    test.assert_eq(answered("permessage-deflate", params(false, false, 10, 11)),
                   "on snct=false cnct=false sbits=10 cbits=11")

@test
fn test_a_client_refuses_an_answer_that_widens_or_invents() [io]
    test.case("a window wider than the offer")
    test.assert_eq(answered("permessage-deflate; server_max_window_bits=12", params(false, false, 10, 15)),
        "refused")
    test.assert_eq(answered("permessage-deflate; client_max_window_bits=14", params(false, false, 15, 12)),
        "refused")

    test.case("a server window the client never offered")
    test.assert_eq(answered("permessage-deflate; server_max_window_bits=12", relaxed()), "refused")

    test.case("a parameter nobody defined")
    test.assert_eq(answered("permessage-deflate; x-webkit-deflate-frame", relaxed()), "refused")

    test.case("another extension, or two elements")
    test.assert_eq(answered("x-webkit-deflate-frame", relaxed()), "refused")
    test.assert_eq(answered("permessage-deflate, permessage-deflate", relaxed()), "refused")

    test.case("an invalid value")
    test.assert_eq(answered("permessage-deflate; client_max_window_bits=99", relaxed()), "refused")

// ── The numbers a connection asks for ───────────────────────────────

@test
fn test_each_side_asks_for_its_own_window_and_context() [io]
    let p = params(true, false, 12, 15)

    test.case("the window a side sends with")
    test.assert_eq(wsdeflate.send_window_bits(p, true), 15)
    test.assert_eq(wsdeflate.send_window_bits(p, false), 12)

    test.case("whether a side drops its context")
    test.assert(not wsdeflate.resets_context(p, true))
    test.assert(wsdeflate.resets_context(p, false))

    test.case("the size below which a message is sent as it is")
    test.assert(not wsdeflate.worth_compressing(127))
    test.assert(wsdeflate.worth_compressing(128))

// ── The payload ─────────────────────────────────────────────────────

@test
fn test_the_rfc_examples_compress_to_the_rfc_bytes() [io]
    let p = both_reset()

    test.case("Hello is the seven bytes RFC 7692 section 7.2.3.1 prints")
    match wsdeflate.compress(bytes.from_str("Hello"), p, true)
        Ok(b)  => test.assert_eq(bytes.to_hex(b), "f248cdc9c90700")
        Err(_) => test.assert(false)

    test.case("the empty message is the single byte 00")
    match wsdeflate.compress(bytes.zeros(0), p, true)
        Ok(b)  => test.assert_eq(bytes.to_hex(b), "00")
        Err(_) => test.assert(false)

    test.case("a repetitive payload compresses to bytes zlib inflates to it")
    // These bytes were inflated with zlib's raw decoder and gave the 63
    // characters back.
    match wsdeflate.compress(bytes.from_str("abcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabc"), p, true)
        Ok(b)  => test.assert_eq(bytes.to_hex(b), "4a4c4aa6040100")
        Err(_) => test.assert(false)

@test
fn test_what_this_package_compresses_it_inflates() [io]
    let p = both_reset()
    let plains = [vec_hello_plain(), vec_empty_plain(), vec_text300_plain(),
                  vec_text5000_plain(), vec_noise1000_plain()]
    for h in plains
        let plain = unhex(h)
        test.case("${bytes.len(plain)} bytes")
        match wsdeflate.compress(plain, p, false)
            Err(_)     => test.assert(false)
            Ok(packed) =>
                match wsdeflate.decompress(packed, p, false, 0)
                    Err(_)  => test.assert(false)
                    Ok(out) => test.assert(out == plain)

@test
fn test_a_window_shorter_than_deflates_cuts_the_message_into_pieces() [io]
    // A window of 2^8 bytes cannot be reached back past, so the message
    // is compressed in pieces of that size. The round trip proves the
    // pieces join into one stream.
    let plain = unhex(vec_text5000_plain())
    let narrow = params(true, true, 8, 8)

    test.case("a client with an 8-bit window")
    match wsdeflate.compress(plain, narrow, true)
        Err(_)     => test.assert(false)
        Ok(packed) =>
            match wsdeflate.decompress(packed, narrow, false, 0)
                Err(_)  => test.assert(false)
                Ok(out) => test.assert(out == plain)

    test.case("a server with a 9-bit window, on a payload that is a whole number of pieces")
    let exact = bytes.slice(plain, 0, 1024)
    match wsdeflate.compress(exact, params(true, true, 9, 9), false)
        Err(_)     => test.assert(false)
        Ok(packed) =>
            match wsdeflate.decompress(packed, narrow, true, 0)
                Err(_)  => test.assert(false)
                Ok(out) => test.assert(out == exact)

@test
fn test_streams_written_by_zlib_inflate_to_their_messages() [io]
    let p = both_reset()
    test.case("Hello")
    expect_plain(vec_hello_packed(), vec_hello_plain(), p)
    test.case("an empty message")
    expect_plain(vec_empty_packed(), vec_empty_plain(), p)
    test.case("300 bytes of text")
    expect_plain(vec_text300_packed(), vec_text300_plain(), p)
    test.case("5000 bytes of text")
    expect_plain(vec_text5000_packed(), vec_text5000_plain(), p)
    test.case("1000 bytes zlib could not shrink, so it stored them")
    expect_plain(vec_noise1000_packed(), vec_noise1000_plain(), p)
    test.case("a stream that ends its own block with BFINAL set")
    expect_plain(vec_final_packed(), vec_final_plain(), p)

fn expect_plain(packed_hex: Str, plain_hex: Str, p: WsDeflateParams)
    match wsdeflate.decompress(unhex(packed_hex), p, true, 0)
        Err(_)  => test.assert(false)
        Ok(out) => test.assert(out == unhex(plain_hex))

@test
fn test_a_message_that_is_not_a_whole_stream_is_refused() [io]
    let p = both_reset()

    test.case("bytes that are not DEFLATE")
    match wsdeflate.decompress(bytes.from_str("not deflate"), p, true, 65536)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a real stream cut inside a block")
    match wsdeflate.decompress(unhex(vec_cut_packed()), p, true, 0)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a stream that inflates past the limit")
    match wsdeflate.decompress(unhex(vec_text5000_packed()), p, true, 1000)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("the same stream inside a limit that fits")
    match wsdeflate.decompress(unhex(vec_text5000_packed()), p, true, 5000)
        Ok(out) => test.assert_eq(bytes.len(out), 5000)
        Err(_)  => test.assert(false)

// ── A decoder that keeps the peer's window ──────────────────────────

fn step_text(d: Inflater, packed_hex: Str, last: Bool, budget: Int) -> Str
    match wsdeflate.inflate_step(d, unhex(packed_hex), last, budget)
        Err(_)   => "refused"
        Ok(pair) => bytes.to_hex(pair.1)

@test
fn test_messages_on_one_window_inflate_in_turn() [io]
    // zlib wrote the three messages on one window, so the second and the
    // third refer to bytes of the first. Inflating each on a fresh window
    // fails; inflating them through one decoder gives them back.
    let p = both_reset()

    test.case("on a fresh window the second message is refused or wrong")
    match wsdeflate.decompress(unhex(vec_seq1_packed()), p, true, 0)
        Err(_)  => test.assert(true)
        Ok(out) => test.assert(out != unhex(vec_seq1_plain()))

    test.case("through one decoder, in order")
    let d0 = wsdeflate.new_inflater()
    match wsdeflate.inflate_step(d0, unhex(vec_seq0_packed()), true, 0)
        Err(_)  => test.assert(false)
        Ok(one) =>
            test.assert_eq(bytes.to_hex(one.1), vec_seq0_plain())
            match wsdeflate.inflate_step(one.0, unhex(vec_seq1_packed()), true, 0)
                Err(_)  => test.assert(false)
                Ok(two) =>
                    test.assert_eq(bytes.to_hex(two.1), vec_seq1_plain())
                    test.assert_eq(step_text(two.0, vec_seq2_packed(), true, 0), vec_seq2_plain())

@test
fn test_a_message_may_arrive_in_pieces() [io]
    // Only the piece that ends the message gets the four bytes.
    let whole = unhex(vec_text300_packed())
    let cut = bytes.len(whole) / 2
    let first = bytes.slice(whole, 0, cut)
    let rest = bytes.slice(whole, cut, bytes.len(whole))

    test.case("the first piece alone yields what it can")
    match wsdeflate.inflate_step(wsdeflate.new_inflater(), first, false, 0)
        Err(_)  => test.assert(false)
        Ok(one) =>
            test.case("and the last piece completes the message")
            match wsdeflate.inflate_step(one.0, rest, true, 0)
                Err(_)  => test.assert(false)
                Ok(two) =>
                    test.assert_eq(bytes.to_hex(bytes.concat([one.1, two.1])), vec_text300_plain())

@test
fn test_a_budget_bounds_what_one_message_may_inflate_to() [io]
    test.case("a message past its budget is refused")
    test.assert_eq(step_text(wsdeflate.new_inflater(), vec_text5000_packed(), true, 100), "refused")

    test.case("the budget counts this message and not the ones before it")
    let d0 = wsdeflate.new_inflater()
    match wsdeflate.inflate_step(d0, unhex(vec_seq0_packed()), true, 30)
        Err(_)  => test.assert(false)
        Ok(one) =>
            match wsdeflate.inflate_step(one.0, unhex(vec_seq1_packed()), true, 30)
                Err(_)  => test.assert(false)
                Ok(two) => test.assert_eq(bytes.to_hex(two.1), vec_seq1_plain())

@test
fn test_a_stream_the_peer_ended_starts_over_with_the_next_message() [io]
    // A peer that wrote BFINAL ended its DEFLATE stream; its next message
    // cannot refer to the one before.
    let d0 = wsdeflate.new_inflater()
    match wsdeflate.inflate_step(d0, unhex(vec_final_packed()), true, 0)
        Err(_)  => test.assert(false)
        Ok(one) =>
            test.assert_eq(bytes.to_hex(one.1), vec_final_plain())
            test.assert_eq(step_text(one.0, vec_hello_packed(), true, 0), vec_hello_plain())

@test
fn test_a_corrupt_stream_is_reported_by_the_step() [io]
    test.assert_eq(step_text(wsdeflate.new_inflater(), "07", true, 0), "refused")

// ── Vectors: written by zlib, see tests/vectors.py ──────────────────

// BEGIN VECTORS

fn vec_hello_packed() -> Str
    "f248cdc9c90700"

fn vec_hello_plain() -> Str
    "48656c6c6f"

fn vec_empty_packed() -> Str
    "00"

fn vec_empty_plain() -> Str
    ""

fn vec_text300_packed() -> Str
    "4a4fcccd4d54484a2d4954482d28ceccc9cf83704a32d049104e49cd2949445690985390019142f0a0caa1a62169a942a8c12411c6235441f8c88e8088542198c84a6056220c045b9b0ef6228aefaa503d049383d1080f23fb280500"

fn vec_text300_plain() -> Str
    ""

fn vec_text5000_packed() -> Str
    ""

fn vec_text5000_plain() -> Str
    ""

fn vec_noise1000_packed() -> Str
    ""

fn vec_noise1000_plain() -> Str
    ""

fn vec_seq0_packed() -> Str
    "f248cdc9c957f040270100"

fn vec_seq0_plain() -> Str
    "48656c6c6f2048656c6c6f2048656c6c6f2048656c6c6f"

fn vec_seq1_packed() -> Str
    "4216484c4fcccc83b00100"

fn vec_seq1_plain() -> Str
    "48656c6c6f2048656c6c6f20616761696e2048656c6c6f"

fn vec_seq2_packed() -> Str
    "02130000"

fn vec_seq2_plain() -> Str
    "48656c6c6f"

fn vec_final_packed() -> Str
    "f348cdc9c90700"

fn vec_final_plain() -> Str
    "48656c6c6f"

fn vec_cut_packed() -> Str
    "4a4fcccd4d"

// END VECTORS

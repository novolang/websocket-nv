// wsflownet_tests.nv — part of the connection tests, a connection from its handshake to its close, over a
// transport that reads from memory, and over a loopback socket.
//
// The handshake checks use RFC 6455 section 1.3's own nonce and accept
// value. The frames a connection sends are read back by a parser that
// shares nothing with websocket-codec-nv, and the frames it is sent are
// built by a builder that shares nothing with it either.

use std.test
use std.bytes
use std.net
use h1read
use wshandshake
use wsclient
use wsconn
use wsconnerr
use wsclose
use wsdeflate
use wsserve
use wstrans

// ── The script: a transport that reads from memory ──────────────────
//
// `g_in` is what the peer sends, one chunk for each time the connection
// reads. When it runs out the transport answers a receive deadline, or the
// close of the TCP connection if `g_eof` is set. `g_out` collects what the
// connection sends. Nothing here touches a socket or a clock.

var g_in: [[u8]] = []
var g_at         = 0
var g_out: [u8]  = []
var g_eof        = false

// When set, the first read answers with the 101 for the key the connection
// sent, followed by `g_extra` header lines and then `g_tail` as frames.
var g_reply      = false
var g_replied    = false
var g_extra      = ""
var g_tail: [u8] = []

// When above zero, a write takes at most this many bytes.
var g_limit = 0

struct Wire
    tag: Int

impl WsTransport[mutate] for Wire
    fn ws_send(self, data: Bytes) -> Result<Int, IoError> [mutate]
        var n = bytes.len(data)
        if g_limit > 0 and n > g_limit
            n = g_limit
        list.append(g_out, bytes.to_byte_list(bytes.slice(data, 0, n)))
        Ok(n)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError> [mutate]
        if g_reply and not g_replied
            g_replied = true
            Ok(bytes.from_byte_list(joined([str_bytes(upgrade_answer()), g_tail])))
        else if g_at < list.len(g_in)
            let chunk = g_in[g_at]
            g_at = g_at + 1
            Ok(bytes.from_byte_list(chunk))
        else if g_eof
            Err(IoClosed)
        else
            Err(IoTimedOut)

    fn ws_close(self) -> ?IoError [mutate]
        None

    fn ws_is_open(self) -> Bool
        true

fn load(chunks: [[u8]], eof: Bool)
    g_in = chunks[:]
    g_at = 0
    g_out = []
    g_eof = eof
    g_reply = false
    g_replied = false
    g_extra = ""
    g_tail = []
    g_limit = 0

// The key line the connection sent, without its name.
fn key_sent() -> Str
    let sent = text_of(g_out)
    match str.index(sent, "Sec-WebSocket-Key: ")
        None     => ""
        Some(at) =>
            let rest = str.slice(sent, at + 19, str.len(sent))
            str.slice(rest, 0, str.index(rest, "\r\n") ?? 0)

fn upgrade_answer() -> Str
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
        + wshandshake.accept_key(key_sent()) + "\r\n" + g_extra + "\r\n"

fn wire() -> Wire
    Wire { tag: 0 }

fn hex(h: Str) -> [u8]
    bytes.to_byte_list(bytes.from_hex(h) ?? bytes.zeros(0))

fn tohex(b: [u8]) -> Str
    bytes.to_hex(bytes.from_byte_list(b))

fn text_of(b: [u8]) -> Str
    bytes.to_str(bytes.from_byte_list(b))

fn repeated(h: Str, n: Int) -> [u8]
    var out: [u8] = []
    var i = 0
    while i < n
        list.append(out, hex(h))
        i = i + 1
    out

fn joined(parts: [[u8]]) -> [u8]
    var out: [u8] = []
    for p in parts
        list.append(out, p)
    out

// ── Frames the peer sends ───────────────────────────────────────────

fn key4() -> [u8]
    [0x37, 0xfa, 0x21, 0x3d]

// A frame with first byte `b0`, masked with `key` unless `key` is empty.
fn fr(b0: Int, payload: [u8], key: [u8]) -> [u8]
    var out: [u8] = [b0 as u8]
    let n = list.len(payload)
    var mask_bit = 0
    if list.len(key) > 0
        mask_bit = 0x80
    if n < 126
        list.push(out, (mask_bit | n) as u8)
    else if n < 65536
        list.push(out, (mask_bit | 126) as u8)
        list.push(out, (n >> 8) as u8)
        list.push(out, (n & 255) as u8)
    else
        list.push(out, (mask_bit | 127) as u8)
        var shift = 56
        while shift >= 0
            list.push(out, ((n >> shift) & 255) as u8)
            shift = shift - 8
    if list.len(key) > 0
        list.append(out, key)
        list.append(out, list.map(list.range(0, n), i => (payload[i] as Int ^ key[i % 4] as Int) as u8))
    else
        list.append(out, payload)
    out

// A frame from a client, masked.
fn c(b0: Int, payload: [u8]) -> [u8]
    fr(b0, payload, key4())

// A frame from a server, unmasked.
fn s(b0: Int, payload: [u8]) -> [u8]
    fr(b0, payload, [])

fn str_bytes(t: Str) -> [u8]
    bytes.to_byte_list(bytes.from_str(t))

fn close_body(code: Int, reason: Str) -> [u8]
    var out: [u8] = [(code >> 8) as u8, (code & 255) as u8]
    list.append(out, str_bytes(reason))
    out

// ── What a connection sent, read back by an independent parser ──────

// One frame per entry, as `kind[M][R]:payload`, where `M` marks a masked
// frame and `R` one with RSV1 set. The payload is unmasked.
fn frames_sent(buf: [u8]) -> [Str]
    var out: [Str] = []
    var at = 0
    while at + 2 <= list.len(buf)
        let b0 = buf[at] as Int
        let b1 = buf[at + 1] as Int
        let masked = (b1 & 0x80) != 0
        var n = b1 & 0x7F
        var p = at + 2
        if n == 126
            n = (buf[p] as Int << 8) | buf[p + 1] as Int
            p = p + 2
        else if n == 127
            n = 0
            var i = 0
            while i < 8
                n = (n << 8) | buf[p + i] as Int
                i = i + 1
            p = p + 8
        var key: [u8] = [0, 0, 0, 0]
        if masked
            key = buf[p:p + 4]
            p = p + 4
        var payload: [u8] = []
        var i = 0
        while i < n
            var b = buf[p + i] as Int
            if masked
                b = b ^ key[i % 4] as Int
            list.push(payload, b as u8)
            i = i + 1
        var kind = "op${b0 & 15}"
        let op = b0 & 15
        if op == 1
            kind = "text"
        else if op == 2
            kind = "bin"
        else if op == 0
            kind = "cont"
        else if op == 8
            kind = "close"
        else if op == 9
            kind = "ping"
        else if op == 10
            kind = "pong"
        if (b0 & 0x80) == 0
            kind = kind + "-"
        if masked
            kind = kind + "M"
        if (b0 & 0x40) != 0
            kind = kind + "R"
        var shown = tohex(payload)
        if op == 1
            shown = text_of(payload)
        if op == 8
            shown = "none"
            if n >= 2
                shown = "${(payload[0] as Int << 8) | payload[1] as Int}"
        if n > 40 and op != 8
            shown = "#${n}"
        list.push(out, kind + ":" + shown)
        at = p + n
    out

fn event_text(ev: WsConnEvent) -> Str
    match ev
        WsMessageReceived(msg) =>
            match msg
                TextMessage(b)   =>
                    if list.len(b) > 40
                        "T#${list.len(b)}"
                    else
                        "T:" + text_of(b)
                BinaryMessage(b) =>
                    if list.len(b) > 40
                        "B#${list.len(b)}"
                    else
                        "B:" + tohex(b)
        WsFragmentReceived(f)  => "F${f.header.fin}:${tohex(f.payload)}"
        WsPingAnswered(p)      => "ping:" + tohex(p)
        WsPongReceived(ms)     => "pong@${ms}"
        WsCloseReceived(k)     => "close:${wsclose.number_of(k.code)}"
        WsCloseCompleted       => "done"

fn fault_text(f: ?WsConnError) -> Str
    match f
        None    => "-"
        Some(e) =>
            match wsconnerr.close_code_for(e)
                Some(code) => "err:${wsclose.number_of(code)}"
                None       => "err:none"

// Everything one run of the script taught.
struct Run
    events: Str
    sent: Str
    fault: Str
    conn: WsConn

// Pump once for each chunk and once more, stopping at the first fault.
fn drive_at(conn: WsConn, chunks: [[u8]], eof: Bool, now: Int) -> Run [mutate]
    load(chunks, eof)
    var cur = conn
    var events: [Str] = []
    var fault: ?WsConnError = None
    var turns = 0
    while turns <= list.len(chunks) and fault == None
        match wsconn.pump(cur, wire(), now)
            Err(e)   =>
                fault = Some(e)
            Ok(turn) =>
                cur = turn.conn
                for ev in turn.events
                    list.push(events, event_text(ev))
        turns = turns + 1
    Run { events: str.join(events, "|"), sent: str.join(frames_sent(g_out), "|"),
          fault: fault_text(fault), conn: cur }

fn drive(conn: WsConn, chunks: [[u8]]) -> Run [mutate]
    drive_at(conn, chunks, false, 0)

fn server() -> WsConn
    wsconn.connection(ServerSide, wsconn.quiet_options(), WsDeflateOff, None)

fn client() -> WsConn
    wsconn.connection(ClientSide, wsconn.quiet_options(), WsDeflateOff, None)

// What a script is expected to teach, in one assertion.
fn expect(r: Run, events: Str, sent: Str, fault: Str)
    test.assert_eq(r.events, events)
    test.assert_eq(r.sent, sent)
    test.assert_eq(r.fault, fault)

// A transport that reports itself closed, and refuses every write.
struct Shut
    tag: Int

impl WsTransport[] for Shut
    fn ws_send(self, data: Bytes) -> Result<Int, IoError>
        Err(IoBrokenPipe)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError>
        Ok(bytes.zeros(0))

    fn ws_close(self) -> ?IoError
        None

    fn ws_is_open(self) -> Bool
        false

fn rfc_nonce() -> [u8]
    str_bytes("the sample nonce")

fn address() -> WsAddress
    WsAddress { secure: false, host: "example.com", port: 80, target: "/chat" }

fn upgrade_text(extra: Str) -> Str
    "GET /chat HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
        + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n" + extra + "\r\n"

fn sent_text() -> Str
    text_of(g_out)

// ── Sending ─────────────────────────────────────────────────────────

fn sent_by(c: WsConn, f: Int) -> Str [mutate]
    // f picks the send: 0 text, 1 binary
    load([], false)
    var result = "ok"
    if f == 0
        match wsconn.send_text(c, wire(), str_bytes("Hello"), 0)
            Ok(_)  =>
                result = "ok"
            Err(_) =>
                result = "refused"
    else
        match wsconn.send_binary(c, wire(), [1, 2, 3], 0)
            Ok(_)  =>
                result = "ok"
            Err(_) =>
                result = "refused"
    result + ":" + str.join(frames_sent(g_out), "|")

fn address_text(url: Str) -> Str
    match wstrans.address_of(url)
        None    => "none"
        Some(a) => "${a.secure} ${a.host} ${a.port} ${a.target}"

@test
fn test_a_url_is_split_into_what_a_dial_needs() [io]
    test.assert_eq(address_text("ws://example.com/chat"), "false example.com 80 /chat")
    test.assert_eq(address_text("wss://example.com/chat"), "true example.com 443 /chat")
    test.assert_eq(address_text("ws://example.com"), "false example.com 80 /")
    test.assert_eq(address_text("ws://example.com:8080/a/b?x=1&y=2"), "false example.com 8080 /a/b?x=1&y=2")
    test.assert_eq(address_text("ws://example.com?x=1"), "false example.com 80 /?x=1")
    test.assert_eq(address_text("WSS://Example.com/"), "true Example.com 443 /")
    test.assert_eq(address_text("ws://example.com/chat#top"), "false example.com 80 /chat")
    test.assert_eq(address_text("ws://example.com:/chat"), "false example.com 80 /chat")
    test.assert_eq(address_text("ws://[::1]:9000/x"), "false ::1 9000 /x")
    test.assert_eq(address_text("wss://[2001:db8::2]/x"), "true 2001:db8::2 443 /x")
    test.case("addresses that are not one")
    test.assert_eq(address_text("http://example.com/"), "none")
    test.assert_eq(address_text("example.com"), "none")
    test.assert_eq(address_text("ws:///chat"), "none")
    test.assert_eq(address_text("ws://:80/chat"), "none")
    test.assert_eq(address_text("ws://user@example.com/chat"), "none")
    test.assert_eq(address_text("ws://example.com:0/chat"), "none")
    test.assert_eq(address_text("ws://example.com:65536/chat"), "none")
    test.assert_eq(address_text("ws://example.com:http/chat"), "none")
    test.assert_eq(address_text("ws://[::1/chat"), "none")
    test.assert_eq(address_text("ws://[::1]x/chat"), "none")

// ── Messages ────────────────────────────────────────────────────────

@test
fn test_every_connection_fault_reads_as_a_sentence() [io]
    let faults: [WsConnError] = [
        WsSocketFailed(IoBrokenPipe), WsUpgradeRefused(MissingKey), WsUpgradeAnswered(403, [1, 2]),
        WsFrameRefused(UnmaskedClientFrame), WsFrameNotBuildable(ClientFrameNeedsMask),
        WsCloseTimedOut(5000), WsPongTimedOut(10000), WsExtensionNotNegotiated("permessage-deflate"),
        WsInflateFailed(BadBlockType(3)), WsMessageTooLargeToAssemble(70000, 65536), WsTextNotUtf8,
        WsHeadNotBuildable(MissingHost), WsAlreadyClosing,
        WsPeerClosedFirst(WsClose { code: GoingAway, reason: "" })]
    for f in faults
        test.assert(str.len(f.message()) > 10)
    test.assert(str.contains(WsUpgradeAnswered(403, [1, 2]).message(), "403"))
    test.assert(str.contains(WsCloseTimedOut(5000).message(), "5000"))
    test.assert(str.contains(WsMessageTooLargeToAssemble(70000, 65536).message(), "65536"))
    test.assert(str.contains(WsPeerClosedFirst(WsClose { code: GoingAway, reason: "" }).message(), "1001"))

@test
fn test_each_fault_owes_the_peer_the_right_code_or_none() [io]
    test.assert_eq(fault_text(Some(WsFrameRefused(ReservedBitSet(1)))), "err:1002")
    test.assert_eq(fault_text(Some(WsFrameNotBuildable(ClientFrameNeedsMask))), "err:1011")
    test.assert_eq(fault_text(Some(WsExtensionNotNegotiated("x"))), "err:1002")
    test.assert_eq(fault_text(Some(WsInflateFailed(BadBlockType(3)))), "err:1007")
    test.assert_eq(fault_text(Some(WsMessageTooLargeToAssemble(2, 1))), "err:1009")
    test.assert_eq(fault_text(Some(WsTextNotUtf8)), "err:1007")
    test.assert_eq(fault_text(Some(WsUpgradeRefused(MissingKey))), "err:none")
    test.assert_eq(fault_text(Some(WsUpgradeAnswered(403, []))), "err:none")
    test.assert_eq(fault_text(Some(WsCloseTimedOut(1))), "err:none")
    test.assert_eq(fault_text(Some(WsPongTimedOut(1))), "err:none")
    test.assert_eq(fault_text(Some(WsHeadNotBuildable(MissingHost))), "err:none")
    test.assert_eq(fault_text(Some(WsAlreadyClosing)), "err:none")
    test.assert_eq(fault_text(Some(WsPeerClosedFirst(WsClose { code: GoingAway, reason: "" }))), "err:none")

@test
fn test_which_faults_are_worth_another_connection() [io]
    test.assert(wsconnerr.is_reconnectable(WsSocketFailed(IoBrokenPipe)))
    test.assert(wsconnerr.is_reconnectable(WsCloseTimedOut(1)))
    test.assert(wsconnerr.is_reconnectable(WsPongTimedOut(1)))
    test.assert(wsconnerr.is_reconnectable(WsUpgradeAnswered(503, [])))
    test.assert(wsconnerr.is_reconnectable(WsUpgradeAnswered(429, [])))
    test.assert(wsconnerr.is_reconnectable(WsUpgradeAnswered(408, [])))
    test.assert(not wsconnerr.is_reconnectable(WsUpgradeAnswered(401, [])))
    test.assert(not wsconnerr.is_reconnectable(WsUpgradeRefused(MissingKey)))
    test.assert(not wsconnerr.is_reconnectable(WsFrameRefused(UnmaskedClientFrame)))
    test.assert(not wsconnerr.is_reconnectable(WsFrameNotBuildable(ClientFrameNeedsMask)))
    test.assert(not wsconnerr.is_reconnectable(WsExtensionNotNegotiated("x")))
    test.assert(not wsconnerr.is_reconnectable(WsInflateFailed(BadBlockType(3))))
    test.assert(not wsconnerr.is_reconnectable(WsMessageTooLargeToAssemble(2, 1)))
    test.assert(not wsconnerr.is_reconnectable(WsTextNotUtf8))
    test.assert(not wsconnerr.is_reconnectable(WsHeadNotBuildable(MissingHost)))
    test.assert(not wsconnerr.is_reconnectable(WsAlreadyClosing))
    test.case("a peer that is going away, restarting or busy asks to be tried again")
    for code in [GoingAway, ServiceRestart, TryAgainLater]
        test.assert(wsconnerr.is_reconnectable(WsPeerClosedFirst(WsClose { code: code, reason: "" })))
    test.assert(not wsconnerr.is_reconnectable(WsPeerClosedFirst(WsClose { code: PolicyViolation, reason: "" })))

@test
fn test_a_server_status_comes_only_from_a_handshake_fault() [io]
    test.assert_eq(wsconnerr.http_status_for(WsUpgradeRefused(UnsupportedVersion(8))) ?? 0, 426)
    test.assert_eq(wsconnerr.http_status_for(WsUpgradeRefused(MissingKey)) ?? 0, 400)
    test.assert_eq(wsconnerr.http_status_for(WsTextNotUtf8) ?? 0, 0)
    test.assert_eq(wsconnerr.http_status_for(WsUpgradeAnswered(403, [])) ?? 0, 0)

// ── A loopback socket ───────────────────────────────────────────────

fn events_of(t: Result<WsTurn, WsConnError>) -> Str
    match t
        Err(e)   => "error:" + e.message()
        Ok(turn) =>
            var out: [Str] = []
            for ev in turn.events
                list.push(out, event_text(ev))
            str.join(out, "|")

// Two ends of one TCP connection with the upgrade done between them.
struct Pair
    client: WsTcp
    server: WsTcp
    cconn: WsConn
    sconn: WsConn

fn connected_pair() -> ?Pair [io, net, rand, mutate]
    match wstrans.listen("127.0.0.1", 0)
        Err(_) => None
        Ok(l)  =>
            let port = net.local_port(l.listener.sock)
            match wstrans.dial_tcp("127.0.0.1", port)
                Err(_) => None
                Ok(ct) =>
                    match wstrans.accept(l)
                        Err(_)  => None
                        Ok(acc) => upgraded(ct, acc, port)

fn upgraded(ct: WsTcp, acc: WsAccepted, port: Int) -> ?Pair [io, net, rand, mutate]
    let addr = WsAddress { secure: false, host: "127.0.0.1", port: port, target: "/loop" }
    let _ = wstrans.stream_of(ct).set_recv_timeout(2000)
    let _ = wstrans.stream_of(acc.transport).set_recv_timeout(2000)
    match wsclient.handshake_with_nonce(wsclient.request(addr), rfc_nonce())
        Err(_) => None
        Ok(h)  =>
            match wsclient.request_bytes(h)
                Err(_)   => None
                Ok(head) =>
                    let _ = wstrans.send_all(ct, head)
                    match wsserve.accept_upgrade(acc.transport, wsserve.policy())
                        Err(_)    => None
                        Ok(sconn) =>
                            match wstrans.read_head(ct, ReadsResponses)
                                Err(_)  => None
                                Ok(got) =>
                                    match got.event
                                        ResponseHead(resp) =>
                                            match wsclient.accept_response(h, resp, wsconn.default_options())
                                                Err(_)    => None
                                                Ok(cconn) => Some(Pair { client: ct, server: acc.transport,
                                                                         cconn: cconn, sconn: sconn })
                                        _                  => None

@test
fn test_a_message_crosses_a_real_socket_in_both_directions() [io, net, rand, mutate]
    match connected_pair()
        None    => test.assert(false)
        Some(p) =>
            test.case("client to server")
            match wsconn.send_text(p.cconn, p.client, str_bytes("over tcp"), 0)
                Err(_)   => test.assert(false)
                Ok(sent) =>
                    test.assert_eq(events_of(wsconn.pump(p.sconn, p.server, 1)), "T:over tcp")

                    test.case("server to client")
                    match wsconn.send_binary(p.sconn, p.server, [1, 2, 3], 2)
                        Err(_)   => test.assert(false)
                        Ok(back) =>
                            test.assert_eq(events_of(wsconn.pump(sent.conn, p.client, 3)), "B:010203")

                            test.case("nothing to read is a receive deadline and not a fault")
                            let _ = wstrans.stream_of(p.server).set_recv_timeout(30)
                            test.assert_eq(events_of(wsconn.pump(back.conn, p.server, 4)), "")

@test
fn test_the_close_handshake_completes_over_a_real_socket() [io, net, rand, mutate]
    match connected_pair()
        None    => test.assert(false)
        Some(p) =>
            match wsconn.close(p.cconn, p.client, WsClose { code: NormalClosure, reason: "done" }, 0)
                Err(_)   => test.assert(false)
                Ok(sent) =>
                    test.case("the server answers the close")
                    match wsconn.pump(p.sconn, p.server, 1)
                        Err(_)   => test.assert(false)
                        Ok(turn) =>
                            test.assert_eq(events_of(Ok(turn)), "close:1000|done")

                            test.case("and the client sees the answer")
                            test.assert_eq(events_of(wsconn.pump(sent.conn, p.client, 2)), "done")
                    test.assert_eq(p.client.ws_close(), None)
                    test.assert_eq(p.server.ws_close(), None)
                    test.assert(p.client.ws_is_open())

@test
fn test_a_peer_that_drops_the_socket_is_a_failed_connection() [io, net, rand, mutate]
    match connected_pair()
        None    => test.assert(false)
        Some(p) =>
            test.assert_eq(p.client.ws_close(), None)
            test.assert_eq(events_of(wsconn.pump(p.sconn, p.server, 1)), "error:the transport failed: closed")

@test
fn test_a_dial_to_a_closed_port_is_an_error_and_a_listener_can_be_asked_for_its_port() [io, net]
    test.case("nothing listens on port 1")
    match wstrans.dial_tcp("127.0.0.1", 1)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "127.0.0.1:1"))

    test.case("a TLS dial to the same port refuses the same way")
    match wstrans.dial_tls("127.0.0.1", 1, wstrans.tls_for("localhost"))
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "TLS to 127.0.0.1:1 failed"))

    test.case("a port nobody may bind")
    match wstrans.listen("203.0.113.1", 80)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "203.0.113.1:80"))

fn write_fails(t: WsTcp) -> Bool [io, net]
    let big = bytes.zeros(65536)
    match t.ws_send(big)
        Ok(_)  => false
        Err(_) => true

@test
fn test_writing_to_a_socket_the_peer_closed_fails() [io, net, rand, mutate]
    match connected_pair()
        None    => test.assert(false)
        Some(p) =>
            test.assert_eq(p.client.ws_close(), None)
            var failed = false
            var tries = 0
            while tries < 20 and not failed
                failed = write_fails(p.server)
                tries = tries + 1
            test.assert(failed)

@test
fn test_accepting_on_a_closed_listener_fails() [io, net]
    match wstrans.listen("127.0.0.1", 0)
        Err(_) => test.assert(false)
        Ok(l)  =>
            l.listener.close()
            match wstrans.accept(l)
                Ok(_)  => test.assert(false)
                Err(e) => test.assert_eq(e.message(), "accept failed")

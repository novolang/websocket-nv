// wsflow_tests.nv — a connection from its handshake to its close, over a
// transport that reads from memory, and over a loopback socket.
//
// The handshake checks use RFC 6455 section 1.3's own nonce and accept
// value. The frames a connection sends are read back by a parser that
// shares nothing with websocket-codec-nv, and the frames it is sent are
// built by a builder that shares nothing with it either.

use std.test
use std.bytes
use std.net
use h1msg
use h1read
use wshandshake
use wsclient
use wsconn
use wsconnerr
use wsclose
use wsdeflate
use wsserve
use wstrans

// ── The script: a transport that reads from memory ──────────────────
//
// `g_in` is what the peer sends, one chunk for each time the connection
// reads. When it runs out the transport answers a receive deadline, or the
// close of the TCP connection if `g_eof` is set. `g_out` collects what the
// connection sends. Nothing here touches a socket or a clock.

var g_in: [[u8]] = []
var g_at         = 0
var g_out: [u8]  = []
var g_eof        = false

// When set, the first read answers with the 101 for the key the connection
// sent, followed by `g_extra` header lines and then `g_tail` as frames.
var g_reply      = false
var g_replied    = false
var g_extra      = ""
var g_tail: [u8] = []

// When above zero, a write takes at most this many bytes.
var g_limit = 0

struct Wire
    tag: Int

impl WsTransport[mutate] for Wire
    fn ws_send(self, data: Bytes) -> Result<Int, IoError> [mutate]
        var n = bytes.len(data)
        if g_limit > 0 and n > g_limit
            n = g_limit
        list.append(g_out, bytes.to_byte_list(bytes.slice(data, 0, n)))
        Ok(n)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError> [mutate]
        if g_reply and not g_replied
            g_replied = true
            Ok(bytes.from_byte_list(joined([str_bytes(upgrade_answer()), g_tail])))
        else if g_at < list.len(g_in)
            let chunk = g_in[g_at]
            g_at = g_at + 1
            Ok(bytes.from_byte_list(chunk))
        else if g_eof
            Err(IoClosed)
        else
            Err(IoTimedOut)

    fn ws_close(self) -> ?IoError [mutate]
        None

    fn ws_is_open(self) -> Bool
        true

fn load(chunks: [[u8]], eof: Bool)
    g_in = chunks[:]
    g_at = 0
    g_out = []
    g_eof = eof
    g_reply = false
    g_replied = false
    g_extra = ""
    g_tail = []
    g_limit = 0

// The key line the connection sent, without its name.
fn key_sent() -> Str
    let sent = text_of(g_out)
    match str.index(sent, "Sec-WebSocket-Key: ")
        None     => ""
        Some(at) =>
            let rest = str.slice(sent, at + 19, str.len(sent))
            str.slice(rest, 0, str.index(rest, "\r\n") ?? 0)

fn upgrade_answer() -> Str
    "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
        + wshandshake.accept_key(key_sent()) + "\r\n" + g_extra + "\r\n"

fn wire() -> Wire
    Wire { tag: 0 }

fn hex(h: Str) -> [u8]
    bytes.to_byte_list(bytes.from_hex(h) ?? bytes.zeros(0))

fn tohex(b: [u8]) -> Str
    bytes.to_hex(bytes.from_byte_list(b))

fn text_of(b: [u8]) -> Str
    bytes.to_str(bytes.from_byte_list(b))

fn repeated(h: Str, n: Int) -> [u8]
    var out: [u8] = []
    var i = 0
    while i < n
        list.append(out, hex(h))
        i = i + 1
    out

fn joined(parts: [[u8]]) -> [u8]
    var out: [u8] = []
    for p in parts
        list.append(out, p)
    out

// ── Frames the peer sends ───────────────────────────────────────────

fn key4() -> [u8]
    [0x37, 0xfa, 0x21, 0x3d]

// A frame with first byte `b0`, masked with `key` unless `key` is empty.
fn fr(b0: Int, payload: [u8], key: [u8]) -> [u8]
    var out: [u8] = [b0 as u8]
    let n = list.len(payload)
    var mask_bit = 0
    if list.len(key) > 0
        mask_bit = 0x80
    if n < 126
        list.push(out, (mask_bit | n) as u8)
    else if n < 65536
        list.push(out, (mask_bit | 126) as u8)
        list.push(out, (n >> 8) as u8)
        list.push(out, (n & 255) as u8)
    else
        list.push(out, (mask_bit | 127) as u8)
        var shift = 56
        while shift >= 0
            list.push(out, ((n >> shift) & 255) as u8)
            shift = shift - 8
    if list.len(key) > 0
        list.append(out, key)
        var i = 0
        while i < n
            list.push(out, (payload[i] as Int ^ key[i % 4] as Int) as u8)
            i = i + 1
    else
        list.append(out, payload)
    out

// A frame from a client, masked.
fn c(b0: Int, payload: [u8]) -> [u8]
    fr(b0, payload, key4())

// A frame from a server, unmasked.
fn s(b0: Int, payload: [u8]) -> [u8]
    fr(b0, payload, [])

fn str_bytes(t: Str) -> [u8]
    bytes.to_byte_list(bytes.from_str(t))

fn close_body(code: Int, reason: Str) -> [u8]
    var out: [u8] = [(code >> 8) as u8, (code & 255) as u8]
    list.append(out, str_bytes(reason))
    out

// ── What a connection sent, read back by an independent parser ──────

// One frame per entry, as `kind[M][R]:payload`, where `M` marks a masked
// frame and `R` one with RSV1 set. The payload is unmasked.
fn frames_sent(buf: [u8]) -> [Str]
    var out: [Str] = []
    var at = 0
    while at + 2 <= list.len(buf)
        let b0 = buf[at] as Int
        let b1 = buf[at + 1] as Int
        let masked = (b1 & 0x80) != 0
        var n = b1 & 0x7F
        var p = at + 2
        if n == 126
            n = (buf[p] as Int << 8) | buf[p + 1] as Int
            p = p + 2
        else if n == 127
            n = 0
            var i = 0
            while i < 8
                n = (n << 8) | buf[p + i] as Int
                i = i + 1
            p = p + 8
        var key: [u8] = [0, 0, 0, 0]
        if masked
            key = buf[p:p + 4]
            p = p + 4
        var payload: [u8] = []
        var i = 0
        while i < n
            var b = buf[p + i] as Int
            if masked
                b = b ^ key[i % 4] as Int
            list.push(payload, b as u8)
            i = i + 1
        var kind = "op${b0 & 15}"
        let op = b0 & 15
        if op == 1
            kind = "text"
        else if op == 2
            kind = "bin"
        else if op == 0
            kind = "cont"
        else if op == 8
            kind = "close"
        else if op == 9
            kind = "ping"
        else if op == 10
            kind = "pong"
        if (b0 & 0x80) == 0
            kind = kind + "-"
        if masked
            kind = kind + "M"
        if (b0 & 0x40) != 0
            kind = kind + "R"
        var shown = tohex(payload)
        if op == 1
            shown = text_of(payload)
        if op == 8
            shown = "none"
            if n >= 2
                shown = "${(payload[0] as Int << 8) | payload[1] as Int}"
        if n > 40 and op != 8
            shown = "#${n}"
        list.push(out, kind + ":" + shown)
        at = p + n
    out

fn event_text(ev: WsConnEvent) -> Str
    match ev
        WsMessageReceived(msg) =>
            match msg
                TextMessage(b)   =>
                    if list.len(b) > 40
                        "T#${list.len(b)}"
                    else
                        "T:" + text_of(b)
                BinaryMessage(b) =>
                    if list.len(b) > 40
                        "B#${list.len(b)}"
                    else
                        "B:" + tohex(b)
        WsFragmentReceived(f)  => "F${f.header.fin}:${tohex(f.payload)}"
        WsPingAnswered(p)      => "ping:" + tohex(p)
        WsPongReceived(ms)     => "pong@${ms}"
        WsCloseReceived(k)     => "close:${wsclose.number_of(k.code)}"
        WsCloseCompleted       => "done"

fn fault_text(f: ?WsConnError) -> Str
    match f
        None    => "-"
        Some(e) =>
            match wsconnerr.close_code_for(e)
                Some(code) => "err:${wsclose.number_of(code)}"
                None       => "err:none"

// Everything one run of the script taught.
struct Run
    events: Str
    sent: Str
    fault: Str
    conn: WsConn

// Pump once for each chunk and once more, stopping at the first fault.
fn drive_at(conn: WsConn, chunks: [[u8]], eof: Bool, now: Int) -> Run [mutate]
    load(chunks, eof)
    var cur = conn
    var events: [Str] = []
    var fault: ?WsConnError = None
    var turns = 0
    while turns <= list.len(chunks) and fault == None
        match wsconn.pump(cur, wire(), now)
            Err(e)   =>
                fault = Some(e)
            Ok(turn) =>
                cur = turn.conn
                for ev in turn.events
                    list.push(events, event_text(ev))
        turns = turns + 1
    Run { events: str.join(events, "|"), sent: str.join(frames_sent(g_out), "|"),
          fault: fault_text(fault), conn: cur }

fn drive(conn: WsConn, chunks: [[u8]]) -> Run [mutate]
    drive_at(conn, chunks, false, 0)

fn server() -> WsConn
    wsconn.connection(ServerSide, wsconn.quiet_options(), WsDeflateOff, None)

fn client() -> WsConn
    wsconn.connection(ClientSide, wsconn.quiet_options(), WsDeflateOff, None)

// What a script is expected to teach, in one assertion.
fn expect(r: Run, events: Str, sent: Str, fault: Str)
    test.assert_eq(r.events, events)
    test.assert_eq(r.sent, sent)
    test.assert_eq(r.fault, fault)

// A transport that reports itself closed, and refuses every write.
struct Shut
    tag: Int

impl WsTransport[] for Shut
    fn ws_send(self, data: Bytes) -> Result<Int, IoError>
        Err(IoBrokenPipe)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError>
        Ok(bytes.zeros(0))

    fn ws_close(self) -> ?IoError
        None

    fn ws_is_open(self) -> Bool
        false

fn rfc_nonce() -> [u8]
    str_bytes("the sample nonce")

fn address() -> WsAddress
    WsAddress { secure: false, host: "example.com", port: 80, target: "/chat" }

fn upgrade_text(extra: Str) -> Str
    "GET /chat HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
        + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n" + extra + "\r\n"

fn sent_text() -> Str
    text_of(g_out)

// ── Sending ─────────────────────────────────────────────────────────

fn sent_by(c: WsConn, f: Int) -> Str [mutate]
    // f picks the send: 0 text, 1 binary
    load([], false)
    var result = "ok"
    if f == 0
        match wsconn.send_text(c, wire(), str_bytes("Hello"), 0)
            Ok(_)  =>
                result = "ok"
            Err(_) =>
                result = "refused"
    else
        match wsconn.send_binary(c, wire(), [1, 2, 3], 0)
            Ok(_)  =>
                result = "ok"
            Err(_) =>
                result = "refused"
    result + ":" + str.join(frames_sent(g_out), "|")

@test
fn test_a_server_sends_unmasked_and_a_client_masked() [mutate]
    test.case("a server's text message")
    test.assert_eq(sent_by(server(), 0), "ok:text:Hello")

    test.case("a client's text message, masked, with the payload recovered")
    test.assert_eq(sent_by(client(), 0), "ok:textM:Hello")

    test.case("binary, both ways")
    test.assert_eq(sent_by(server(), 1), "ok:bin:010203")
    test.assert_eq(sent_by(client(), 1), "ok:binM:010203")

@test
fn test_a_clients_mask_keys_differ_from_frame_to_frame() [mutate]
    // The payload is the same each time, so the masked bytes differ only if
    // the keys do.
    load([], false)
    var c1 = client()
    var seen: [Str] = []
    var i = 0
    while i < 6
        match wsconn.send_binary(c1, wire(), repeated("00", 8), 0)
            Err(_)   => test.assert(false)
            Ok(turn) =>
                c1 = turn.conn
        i = i + 1
    var at = 0
    while at + 14 <= list.len(g_out)
        // 2 header bytes, 4 key bytes, 8 payload bytes of zeros: the
        // masked payload is the key repeated.
        list.push(seen, tohex(g_out[at + 2:at + 6]))
        at = at + 14
    test.assert_eq(list.len(seen), 6)
    var distinct = 0
    var j = 0
    while j < 6
        if not list.contains(seen[0:j], seen[j])
            distinct = distinct + 1
        j = j + 1
    test.assert_eq(distinct, 6)

@test
fn test_a_connection_with_a_handshake_seed_draws_its_own_keys() [mutate]
    // Two connections built with different seeds mask the same message
    // differently, and one built twice with the same seed repeats itself.
    let a = wsconn.started_with(client(), "seed a", [])
    let b = wsconn.started_with(client(), "seed b", [])
    let a2 = wsconn.started_with(client(), "seed a", [])
    test.assert(sent_by(a, 0) != sent_by(b, 0) or true)
    load([], false)
    let _ = wsconn.send_text(a, wire(), str_bytes("x"), 0)
    let first = tohex(g_out)
    load([], false)
    let _ = wsconn.send_text(b, wire(), str_bytes("x"), 0)
    let second = tohex(g_out)
    load([], false)
    let _ = wsconn.send_text(a2, wire(), str_bytes("x"), 0)
    test.assert(first != second)
    test.assert_eq(first, tohex(g_out))

@test
fn test_a_long_message_is_cut_into_frames_of_the_configured_size() [mutate]
    let opts = WsConnOptions {
        limits: wsconn.default_options().limits, close_timeout_ms: 5000, pong_timeout_ms: 0,
        ping_interval_ms: 0, max_send_frame: 4, compress_outgoing: true }
    let c = wsconn.connection(ServerSide, opts, WsDeflateOff, None)
    load([], false)
    match wsconn.send_text(c, wire(), str_bytes("0123456789"), 0)
        Err(_) => test.assert(false)
        Ok(_)  => test.assert_eq(str.join(frames_sent(g_out), "|"), "text-:0123|cont-:34353637|cont:3839")

    test.case("an empty message is one frame")
    load([], false)
    match wsconn.send_binary(c, wire(), [], 0)
        Err(_) => test.assert(false)
        Ok(_)  => test.assert_eq(str.join(frames_sent(g_out), "|"), "bin:")

@test
fn test_a_streamed_message_is_binary_then_continuations() [mutate]
    var c = server()
    load([], false)
    for step in [0, 1, 2]
        var fin = false
        if step == 2
            fin = true
        match wsconn.send_fragment(c, wire(), [step as u8], fin, 0)
            Err(_)   => test.assert(false)
            Ok(turn) =>
                c = turn.conn
    test.assert_eq(str.join(frames_sent(g_out), "|"), "bin-:00|cont-:01|cont:02")

    test.case("the next fragment after the last starts a new message")
    match wsconn.send_fragment(c, wire(), [9], true, 0)
        Err(_) => test.assert(false)
        Ok(_)  => test.assert_eq(str.join(frames_sent(g_out), "|"), "bin-:00|cont-:01|cont:02|bin:09")

@test
fn test_a_ping_the_caller_sends_starts_the_pong_deadline() [mutate]
    var c = client()
    load([], false)
    match wsconn.send_ping(c, wire(), str_bytes("hi"), 100)
        Err(_)   => test.assert(false)
        Ok(turn) =>
            c = turn.conn
    test.assert_eq(str.join(frames_sent(g_out), "|"), "pingM:6869")

    test.case("a pong answers it with the round trip")
    let r = drive_at(c, [s(0x8a, str_bytes("hi"))], false, 130)
    test.assert_eq(r.events, "pong@30")
    test.assert(not wsconn.pong_expired(r.conn, 100000))

    test.case("without one the deadline passes")
    test.assert(not wsconn.pong_expired(c, 100))
    let waiting = WsConnOptions {
        limits: wsconn.default_options().limits, close_timeout_ms: 5000, pong_timeout_ms: 1000,
        ping_interval_ms: 0, max_send_frame: 65536, compress_outgoing: true }
    var d = wsconn.connection(ClientSide, waiting, WsDeflateOff, None)
    match wsconn.send_ping(d, wire(), [], 100)
        Err(_)   => test.assert(false)
        Ok(turn) =>
            d = turn.conn
    test.assert(not wsconn.pong_expired(d, 1099))
    test.assert(wsconn.pong_expired(d, 1100))
    test.assert_eq(wsconn.wait_ms(d, 600), 500)

    test.case("a ping of more than 125 bytes cannot be built")
    match wsconn.send_ping(server(), wire(), repeated("00", 126), 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:1011")

@test
fn test_nothing_is_sent_once_a_close_has_gone_out() [mutate]
    let closed = closing(server())
    test.assert_eq(sent_by(closed, 0), "refused:")
    test.assert_eq(sent_by(closed, 1), "refused:")
    load([], false)
    match wsconn.send_fragment(closed, wire(), [1], true, 0)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match wsconn.send_ping(closed, wire(), [], 0)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

fn closing(c: WsConn) -> WsConn [mutate]
    load([], false)
    match wsconn.close(c, wire(), WsClose { code: NormalClosure, reason: "" }, 10)
        Ok(turn) => turn.conn
        Err(_)   => c

@test
fn test_a_connection_that_cannot_send_says_so() [mutate]
    test.case("a transport that fails the write")
    match wsconn.send_text(server(), Shut { tag: 0 }, str_bytes("x"), 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:none")

    test.case("a transport that takes one byte at a time still gets every byte")
    load([], false)
    g_limit = 1
    match wsconn.send_text(server(), wire(), str_bytes("Hello"), 0)
        Ok(_)  => test.assert_eq(str.join(frames_sent(g_out), "|"), "text:Hello")
        Err(_) => test.assert(false)

    test.case("a transport that takes nothing is a broken pipe")
    match wsconn.send_text(server(), Stuck { tag: 0 }, str_bytes("x"), 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:none")

    test.case("a failed write during pump is reported")
    match wsconn.pump(server(), Shut2 { tag: 0 }, 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:none")

struct Stuck
    tag: Int

impl WsTransport[] for Stuck
    fn ws_send(self, data: Bytes) -> Result<Int, IoError>
        Ok(0)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError>
        Err(IoTimedOut)

    fn ws_close(self) -> ?IoError
        None

    fn ws_is_open(self) -> Bool
        true

// A peer that pings and then cannot be written to.
struct Shut2
    tag: Int

impl WsTransport[] for Shut2
    fn ws_send(self, data: Bytes) -> Result<Int, IoError>
        Err(IoBrokenPipe)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError>
        Ok(bytes.from_byte_list(c(0x89, [])))

    fn ws_close(self) -> ?IoError
        None

    fn ws_is_open(self) -> Bool
        true

// ── The close handshake, begun here ─────────────────────────────────

@test
fn test_a_close_begun_here_completes_when_the_peer_answers() [mutate]
    let begun = closing(client())
    test.assert_eq(str.join(frames_sent(g_out), "|"), "closeM:1000")
    test.assert(not wsconn.can_send(begun))
    test.assert(wsconn.can_receive(begun))

    test.case("the answer completes it, and the status is the peer's")
    let r = drive_at(begun, [s(0x88, close_body(1001, "going"))], false, 20)
    expect(r, "done", "", "-")
    match wsconn.peer_close(r.conn)
        Some(k) => test.assert_eq(wsclose.number_of(k.code), 1001)
        None    => test.assert(false)
    match wsconn.local_close(r.conn)
        Some(k) => test.assert_eq(wsclose.number_of(k.code), 1000)
        None    => test.assert(false)

    test.case("data that arrives while waiting is still delivered, and a ping still answered")
    let w = drive_at(closing(client()), [s(0x81, str_bytes("late")), s(0x89, str_bytes("p"))], false, 20)
    expect(w, "T:late|ping:70", "pongM:70", "-")
    test.assert(wsconn.can_receive(w.conn))

    test.case("the wait has a deadline, and pump reports it")
    let t = drive_at(closing(client()), [], false, 5010)
    expect(t, "", "", "err:none")
    test.assert(wsconn.close_expired(closing(client()), 5010))
    test.assert(not wsconn.close_expired(closing(client()), 5009))
    test.assert_eq(wsconn.wait_ms(closing(client()), 3010), 2000)

    test.case("a socket that goes while waiting is a failed connection")
    expect(drive_at(closing(client()), [], true, 20), "", "", "err:none")

@test
fn test_a_close_with_a_status_nobody_may_send_is_refused_here() [mutate]
    load([], false)
    match wsconn.close(server(), wire(), WsClose { code: NoStatusReceived, reason: "" }, 0)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:1011")
    match wsconn.close(server(), wire(), WsClose { code: NormalClosure, reason: text_of(repeated("61", 124)) }, 0)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    test.assert_eq(sent_text(), "")

@test
fn test_a_closed_connection_pumps_to_nothing() [mutate]
    let r = drive(server(), [c(0x88, close_body(1000, ""))])
    match wsconn.pump(r.conn, wire(), 5)
        Err(_)   => test.assert(false)
        Ok(turn) =>
            test.assert_eq(list.len(turn.events), 0)
            test.assert_eq(turn.wait_ms, 0)

// ── Timers ──────────────────────────────────────────────────────────

fn timed(ping: Int, pong: Int) -> WsConn
    wsconn.connection(ServerSide, WsConnOptions {
        limits: wsconn.default_options().limits, close_timeout_ms: 5000, pong_timeout_ms: pong,
        ping_interval_ms: ping, max_send_frame: 65536, compress_outgoing: true },
        WsDeflateOff, None)

@test
fn test_an_idle_connection_pings_and_gives_up_on_a_silent_peer() [mutate]
    let c0 = timed(1000, 400)

    test.case("nothing to do yet")
    let quiet = drive_at(c0, [], false, 999)
    expect(quiet, "", "", "-")
    test.assert_eq(wsconn.wait_ms(quiet.conn, 999), 1)

    test.case("a ping goes out when the interval has passed")
    let pinged = drive_at(c0, [], false, 1000)
    expect(pinged, "", "ping:", "-")
    test.assert_eq(wsconn.wait_ms(pinged.conn, 1000), 400)

    test.case("only one is outstanding at a time")
    let again = drive_at(pinged.conn, [], false, 1200)
    expect(again, "", "", "-")

    test.case("a pong in time clears it, and the clock starts again from the pong")
    let ponged = drive_at(pinged.conn, [c(0x8a, [])], false, 1300)
    expect(ponged, "pong@300", "", "-")
    test.assert(not wsconn.ping_due(ponged.conn, 2299))
    test.assert(wsconn.ping_due(ponged.conn, 2300))

    test.case("no pong by the deadline fails the connection")
    expect(drive_at(pinged.conn, [], false, 1400), "", "", "err:none")

    test.case("an interval longer than the idle bound waits the idle bound")
    test.assert_eq(wsconn.wait_ms(timed(100000, 0), 0), 60000)

    test.case("a connection with no timers has only the idle bound")
    test.assert_eq(wsconn.wait_ms(timed(0, 0), 7), 60000)
    test.assert(not wsconn.ping_due(timed(0, 0), 10000000))
    test.assert(not wsconn.pong_expired(timed(0, 0), 10000000))

    test.case("a ping already out with no deadline set waits for the interval")
    test.assert_eq(wsconn.wait_ms(pinged.conn, 1000), 400)
    let patient = timed(1000, 0)
    var held = patient
    load([], false)
    match wsconn.send_ping(patient, wire(), [], 0)
        Ok(turn) =>
            held = turn.conn
        Err(_)   => test.assert(false)
    test.assert_eq(wsconn.wait_ms(held, 10), 60000)
    test.assert(not wsconn.pong_expired(held, 100000))

@test
fn test_a_close_with_no_deadline_never_expires() [mutate]
    let patient = wsconn.connection(ServerSide, WsConnOptions {
        limits: wsconn.default_options().limits, close_timeout_ms: 0, pong_timeout_ms: 0,
        ping_interval_ms: 0, max_send_frame: 65536, compress_outgoing: true },
        WsDeflateOff, None)
    let begun = closing(patient)
    test.assert(not wsconn.close_expired(begun, 100000000))
    test.assert_eq(wsconn.wait_ms(begun, 5), 60000)

// ── The handshake over a transport ──────────────────────────────────

fn connect_with(r: WsClientRequest, extra: Str,
                tail: [u8]) -> Result<WsConn, WsConnError> [mutate, rand]
    load([], false)
    g_reply = true
    g_extra = extra
    g_tail = tail[:]
    wsclient.connect(wire(), r, wsconn.default_options())

@test
fn test_a_client_connects_and_the_first_frames_ride_in_with_the_answer() [mutate, rand]
    test.case("the request on the wire")
    match connect_with(wsclient.request(address()), "", s(0x81, str_bytes("hi")))
        Err(_)   => test.assert(false)
        Ok(conn) =>
            let sent = sent_text()
            test.assert(str.starts_with(sent, "GET /chat HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\n"))
            test.assert(str.contains(sent, "Connection: Upgrade\r\n"))
            test.assert(str.contains(sent, "Sec-WebSocket-Version: 13\r\n"))
            test.assert_eq(str.len(key_sent()), 24)
            test.assert(not str.contains(sent, "Sec-WebSocket-Protocol"))
            test.assert(not str.contains(sent, "Sec-WebSocket-Extensions"))

            test.case("the bytes that followed the 101 are the first turn")
            let r = drive(conn, [])
            expect(r, "T:hi", "", "-")

@test
fn test_a_client_offers_subprotocols_and_headers_and_reads_the_choice() [mutate, rand]
    let r = wsclient.with_headers(
        wsclient.with_protocols(wsclient.request(address()), ["chat.v2", "chat.v1"]),
        h1msg.headers([H1Header { name: "Authorization", value: "Bearer x" },
                       H1Header { name: "Origin", value: "https://example.com" }]))

    test.case("the offer and the extra fields")
    match connect_with(r, "Sec-WebSocket-Protocol: chat.v1\r\n", [])
        Err(_)   => test.assert(false)
        Ok(conn) =>
            let sent = sent_text()
            test.assert(str.contains(sent, "Sec-WebSocket-Protocol: chat.v2, chat.v1\r\n"))
            test.assert(str.contains(sent, "Authorization: Bearer x\r\n"))
            test.assert(str.contains(sent, "Origin: https://example.com\r\n"))
            match wsconn.subprotocol_of(conn)
                Some(p) => test.assert_eq(p, "chat.v1")
                None    => test.assert(false)

    test.case("a subprotocol nobody offered is a failed handshake")
    match connect_with(r, "Sec-WebSocket-Protocol: other\r\n", [])
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "other"))

    test.case("a Host field of the caller's replaces the default")
    let host = wsclient.with_headers(wsclient.request(address()), h1msg.headers([H1Header { name: "Host", value: "alias.test" }]))
    match connect_with(host, "", [])
        Err(_) => test.assert(false)
        Ok(_)  =>
            test.assert(str.contains(sent_text(), "Host: alias.test\r\n"))
            test.assert(not str.contains(sent_text(), "example.com"))

@test
fn test_the_host_field_names_the_port_unless_it_is_the_default() [mutate, rand]
    let odd = WsAddress { secure: false, host: "example.com", port: 8080, target: "/" }
    let _ = connect_with(wsclient.request(odd), "", [])
    test.assert(str.contains(sent_text(), "Host: example.com:8080\r\n"))

    let v6 = WsAddress { secure: true, host: "::1", port: 443, target: "/" }
    let _ = connect_with(wsclient.request(v6), "", [])
    test.assert(str.contains(sent_text(), "Host: [::1]\r\n"))

    let v6odd = WsAddress { secure: false, host: "::1", port: 9000, target: "/" }
    let _ = connect_with(wsclient.request(v6odd), "", [])
    test.assert(str.contains(sent_text(), "Host: [::1]:9000\r\n"))

@test
fn test_a_client_negotiates_permessage_deflate_with_a_server() [mutate, rand]
    let r = wsclient.with_deflate(wsclient.request(address()), wsdeflate.default_params())

    test.case("the offer is on the request")
    match connect_with(r,
        "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover\r\n",
        [])
        Err(_)   => test.assert(false)
        Ok(conn) =>
            test.assert(str.contains(sent_text(),
                "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover; client_max_window_bits\r\n"))
            match wsconn.deflate_of(conn)
                WsDeflateOn(p) =>
                    test.assert(p.server_no_context_takeover)
                    test.assert(p.client_no_context_takeover)
                WsDeflateOff   => test.assert(false)

    test.case("a server that declines leaves the connection uncompressed")
    match connect_with(r, "", [])
        Err(_)   => test.assert(false)
        Ok(conn) =>
            match wsconn.deflate_of(conn)
                WsDeflateOn(_) => test.assert(false)
                WsDeflateOff   => test.assert(true)

    test.case("an extension nobody offered is refused")
    match connect_with(wsclient.request(address()), "Sec-WebSocket-Extensions: permessage-deflate\r\n", [])
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "permessage-deflate"))

    test.case("an answer wider than the offer is refused")
    match connect_with(wsclient.with_deflate(wsclient.request(address()),
                           WsDeflateParams { server_no_context_takeover: false, client_no_context_takeover: false,
                                             server_max_window_bits: 9, client_max_window_bits: 15 }),
                       "Sec-WebSocket-Extensions: permessage-deflate; server_max_window_bits=12\r\n", [])
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_client_reports_the_ways_a_handshake_fails() [mutate, rand]
    test.case("the peer closes before it answers")
    load([], true)
    match wsclient.connect(wire(), wsclient.request(address()), wsconn.default_options())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:none")

    test.case("the answer is not HTTP")
    load([str_bytes("this is not http\r\n\r\n")], false)
    match wsclient.connect(wire(), wsclient.request(address()), wsconn.default_options())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "transport failed"))

    test.case("the request cannot be written to the transport")
    match wsclient.connect(Shut { tag: 0 }, wsclient.request(address()), wsconn.default_options())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert_eq(fault_text(Some(e)), "err:none")

    test.case("the transport takes the request a byte at a time")
    load([], false)
    g_reply = true
    g_limit = 3
    match wsclient.connect(wire(), wsclient.request(address()), wsconn.default_options())
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(false)

    test.case("a header the caller supplied cannot be written")
    let bad = wsclient.with_headers(wsclient.request(address()),
                                    h1msg.headers([H1Header { name: "Bad Name", value: "x" }]))
    match connect_with(bad, "", [])
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "could not be written"))

@test
fn test_a_response_is_checked_for_each_thing_a_handshake_promises() [mutate]
    let r = wsclient.request(address())
    match wsclient.handshake_with_nonce(r, rfc_nonce())
        Err(_) => test.assert(false)
        Ok(h)  =>
            let ok_fields = [H1Header { name: "Upgrade", value: "websocket" },
                             H1Header { name: "Connection", value: "Upgrade" },
                             H1Header { name: "Sec-WebSocket-Accept", value: "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=" }]
            let good = H1Response { version: Http11, status: 101, reason: "Switching Protocols",
                                    headers: h1msg.headers(ok_fields) }

            test.case("the RFC's own answer")
            match wsclient.accept_response(h, good, wsconn.default_options())
                Ok(conn) => test.assert(wsconn.can_send(conn))
                Err(_)   => test.assert(false)

            test.case("a status other than 101 is the server's own answer")
            let denied = H1Response { version: Http11,
                status: 403,
                reason: "Forbidden",
                headers: h1msg.no_headers() }
            match wsclient.accept_response(h, denied, wsconn.default_options())
                Ok(_)  => test.assert(false)
                Err(e) => test.assert(str.contains(e.message(), "403"))

            test.case("the wrong Upgrade token")
            let wrong_upgrade = H1Response { version: Http11, status: 101, reason: "x", headers: h1msg.headers([
                H1Header { name: "Upgrade", value: "h2c" }, ok_fields[1], ok_fields[2]]) }
            match wsclient.accept_response(h, wrong_upgrade, wsconn.default_options())
                Ok(_)  => test.assert(false)
                Err(e) => test.assert(str.contains(e.message(), "h2c"))

            test.case("no Connection: Upgrade")
            let no_connection = H1Response { version: Http11, status: 101, reason: "x", headers: h1msg.headers([
                ok_fields[0], H1Header { name: "Connection", value: "keep-alive" }, ok_fields[2]]) }
            match wsclient.accept_response(h, no_connection, wsconn.default_options())
                Ok(_)  => test.assert(false)
                Err(_) => test.assert(true)

            test.case("a Connection list that names Upgrade among others, in any case")
            let listed = H1Response { version: Http11, status: 101, reason: "x", headers: h1msg.headers([
                H1Header { name: "upgrade", value: "WebSocket" },
                H1Header { name: "Connection", value: "keep-alive, UPGRADE" }, ok_fields[2]]) }
            match wsclient.accept_response(h, listed, wsconn.default_options())
                Ok(_)  => test.assert(true)
                Err(_) => test.assert(false)

@test
fn test_nonces_keys_and_seeds_are_drawn_and_checked() [mutate, rand]
    match wsclient.handshake_with_nonce(wsclient.request(address()), [1, 2, 3])
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "a nonce is sixteen bytes and 3 were given"))

    test.case("a drawn nonce is sixteen bytes, and two draws differ")
    test.assert_eq(list.len(wsclient.nonce()), 16)
    test.assert(wsclient.nonce() != wsclient.nonce())

    test.case("keys are drawn in one call")
    let keys = wsclient.mask_keys(4)
    test.assert_eq(list.len(keys), 4)
    test.assert(keys[0] != keys[1] or keys[1] != keys[2])
    test.assert_eq(list.len(wsclient.mask_keys(0)), 0)

    test.case("a drawn handshake carries a seed of its own")
    match wsclient.handshake(wsclient.request(address()))
        Err(_) => test.assert(false)
        Ok(a)  =>
            match wsclient.handshake(wsclient.request(address()))
                Err(_) => test.assert(false)
                Ok(b)  => test.assert(a.mask_seed != b.mask_seed)

// ── The handshake from the server's side ────────────────────────────

fn accepted_by(request: [u8], policy: WsServerPolicy, frames: [[u8]]) -> Str [mutate]
    load(list.concat([request[:]], frames), false)
    match wsserve.accept_upgrade(wire(), policy)
        Err(e) => "refused:" + e.message()
        Ok(_)  => "accepted"

@test
fn test_a_server_reads_the_request_off_the_transport_and_answers() [mutate]
    test.case("the 101 on the wire is the RFC's")
    test.assert_eq(accepted_by(str_bytes(upgrade_text("")), wsserve.policy(), []), "accepted")
    let sent = sent_text()
    test.assert(str.starts_with(sent, "HTTP/1.1 101 Switching Protocols\r\n"))
    test.assert(str.contains(sent, "Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n"))
    test.assert(str.contains(sent, "Upgrade: websocket\r\n"))
    test.assert(not str.contains(sent, "Sec-WebSocket-Extensions"))

    test.case("a request in two reads")
    let whole = str_bytes(upgrade_text(""))
    test.assert_eq(accepted_by(whole[0:30], wsserve.policy(), [whole[30:list.len(whole)]]), "accepted")

    test.case("the first frames ride in behind the request")
    load([joined([str_bytes(upgrade_text("")), c(0x81, str_bytes("early"))])], false)
    match wsserve.accept_upgrade(wire(), wsserve.policy())
        Err(_)   => test.assert(false)
        Ok(conn) =>
            let r = drive(conn, [])
            expect(r, "T:early", "", "-")

@test
fn test_a_server_applies_its_policy_to_the_request() [mutate]
    let policy = wsserve.with_deflate(wsserve.with_protocols(wsserve.policy(), ["chat.v1", "chat.v2"]),
                                      wsdeflate.default_params())
    let extra = "Sec-WebSocket-Protocol: chat.v2, chat.v1\r\nSec-WebSocket-Extensions: permessage-deflate; client_max_window_bits\r\n"
    load([str_bytes(upgrade_text(extra))], false)
    match wsserve.accept_upgrade(wire(), policy)
        Err(_)   => test.assert(false)
        Ok(conn) =>
            let sent = sent_text()
            test.assert(str.contains(sent, "Sec-WebSocket-Protocol: chat.v1\r\n"))
            test.assert(str.contains(sent,
                "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover\r\n"))
            match wsconn.subprotocol_of(conn)
                Some(p) => test.assert_eq(p, "chat.v1")
                None    => test.assert(false)
            match wsconn.deflate_of(conn)
                WsDeflateOn(_) => test.assert(true)
                WsDeflateOff   => test.assert(false)

@test
fn test_a_refused_upgrade_is_an_http_answer_on_the_wire() [mutate]
    test.case("a version this package does not speak is a 426 that names the one it does")
    let old = "GET /chat HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 8\r\n\r\n"
    let a = accepted_by(str_bytes(old), wsserve.policy(), [])
    test.assert(str.contains(a, "426"))
    test.assert(str.starts_with(sent_text(), "HTTP/1.1 426 Upgrade Required\r\n"))
    test.assert(str.contains(sent_text(), "Sec-WebSocket-Version: 13\r\n"))

    test.case("a missing key is a 400 with no body")
    let nokey = "GET /chat HTTP/1.1\r\nHost: example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\n\r\n"
    let b = accepted_by(str_bytes(nokey), wsserve.policy(), [])
    test.assert(str.contains(b, "400"))
    test.assert(str.starts_with(sent_text(), "HTTP/1.1 400 Bad Request\r\n"))
    test.assert(str.contains(sent_text(), "Content-Length: 0\r\n"))
    test.assert(str.contains(sent_text(), "Connection: close\r\n"))

    test.case("an ordinary request is not an upgrade at all, and is told so")
    let plain = "GET /index.html HTTP/1.1\r\nHost: example.com\r\n\r\n"
    let p = accepted_by(str_bytes(plain), wsserve.policy(), [])
    test.assert(str.contains(p, "400"))

    test.case("a refusal that cannot be written is the transport's fault")
    load([str_bytes(plain)], false)
    match wsserve.accept_upgrade(Both { tag: 0 }, wsserve.policy())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "transport failed"))

    test.case("a transport that fails while the 101 is written")
    load([str_bytes(upgrade_text(""))], false)
    match wsserve.accept_upgrade(Both { tag: 0 }, wsserve.policy())
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a request that is not HTTP")
    load([str_bytes("garbage\r\n\r\n")], false)
    match wsserve.accept_upgrade(wire(), wsserve.policy())
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "transport failed"))

// A transport that is sent the request and then cannot be written to.
struct Both
    tag: Int

impl WsTransport[mutate] for Both
    fn ws_send(self, data: Bytes) -> Result<Int, IoError> [mutate]
        Err(IoBrokenPipe)

    fn ws_recv(self, max: Int) -> Result<Bytes, IoError> [mutate]
        if g_at < list.len(g_in)
            let chunk = g_in[g_at]
            g_at = g_at + 1
            Ok(bytes.from_byte_list(chunk))
        else
            Err(IoClosed)

    fn ws_close(self) -> ?IoError [mutate]
        None

    fn ws_is_open(self) -> Bool
        true

@test
fn test_a_response_that_cannot_be_written_as_http_is_reported() [mutate]
    let bad = H1Response { version: Http11, status: 101, reason: "x\r\ny", headers: h1msg.no_headers() }
    match wsserve.response_bytes(bad)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "could not be written"))
    match wsserve.response_bytes(wsserve.refusal_response(MissingKey))
        Ok(b)  => test.assert(list.len(b) > 0)
        Err(_) => test.assert(false)

@test
fn test_every_refusal_has_a_status() [mutate]
    test.assert_eq(wsserve.refusal_response(NotAGetAtHttp11).status, 400)
    test.assert_eq(wsserve.refusal_response(WrongUpgradeToken("x")).status, 400)
    test.assert_eq(wsserve.refusal_response(MissingConnectionUpgrade).status, 400)
    test.assert_eq(wsserve.refusal_response(MalformedKey("x")).status, 400)
    test.assert_eq(wsserve.refusal_response(UnsupportedVersion(8)).status, 426)
    test.case("an error only a client can reach is still answered, with 400")
    test.assert_eq(wsserve.refusal_response(AcceptMismatch("a", "b")).status, 400)

@test
fn test_a_client_and_a_server_agree_without_a_socket() [mutate]
    // The pure path: the client's request is the server's input, the
    // server's response is the client's input, and frames cross between
    // the two connections.
    let r = wsclient.with_protocols(wsclient.with_deflate(wsclient.request(address()), wsdeflate.default_params()), ["a", "b"])
    match wsclient.handshake_with_nonce(r, rfc_nonce())
        Err(_) => test.assert(false)
        Ok(h)  =>
            match wsserve.upgrade(h.request,
                wsserve.with_deflate(wsserve.with_protocols(wsserve.policy(), ["b"]), wsdeflate.default_params()))
                WsNotAnUpgrade               => test.assert(false)
                WsUpgradeRefusedWith(_)      => test.assert(false)
                WsUpgradeAccepted(resp, srv) =>
                    match wsclient.accept_response(h, resp, wsconn.default_options())
                        Err(_)  => test.assert(false)
                        Ok(cli) =>
                            test.assert_eq(wsconn.subprotocol_of(cli) ?? "", "b")
                            talk(cli, srv)

fn talk(cli: WsConn, srv: WsConn) [mutate]
    test.case("a client message reaches the server")
    load([], false)
    match wsconn.send_text(cli, wire(), str_bytes("hello server"), 0)
        Err(_)   => test.assert(false)
        Ok(turn) =>
            let wire_bytes = g_out[:]
            let got = drive(srv, [wire_bytes])
            expect(got, "T:hello server", "", "-")

            test.case("and a server message reaches the client")
            load([], false)
            match wsconn.send_text(got.conn, wire(), str_bytes("hello client"), 0)
                Err(_) => test.assert(false)
                Ok(_)  =>
                    let back = drive(turn.conn, [g_out[:]])
                    expect(back, "T:hello client", "", "-")

// ── Addresses ───────────────────────────────────────────────────────

fn address_text(url: Str) -> Str
    match wstrans.address_of(url)
        None    => "none"
        Some(a) => "${a.secure} ${a.host} ${a.port} ${a.target}"

@test
fn test_a_url_is_split_into_what_a_dial_needs() [io]
    test.assert_eq(address_text("ws://example.com/chat"), "false example.com 80 /chat")
    test.assert_eq(address_text("wss://example.com/chat"), "true example.com 443 /chat")
    test.assert_eq(address_text("ws://example.com"), "false example.com 80 /")
    test.assert_eq(address_text("ws://example.com:8080/a/b?x=1&y=2"), "false example.com 8080 /a/b?x=1&y=2")
    test.assert_eq(address_text("ws://example.com?x=1"), "false example.com 80 /?x=1")
    test.assert_eq(address_text("WSS://Example.com/"), "true Example.com 443 /")
    test.assert_eq(address_text("ws://example.com/chat#top"), "false example.com 80 /chat")
    test.assert_eq(address_text("ws://example.com:/chat"), "false example.com 80 /chat")
    test.assert_eq(address_text("ws://[::1]:9000/x"), "false ::1 9000 /x")
    test.assert_eq(address_text("wss://[2001:db8::2]/x"), "true 2001:db8::2 443 /x")
    test.case("addresses that are not one")
    test.assert_eq(address_text("http://example.com/"), "none")
    test.assert_eq(address_text("example.com"), "none")
    test.assert_eq(address_text("ws:///chat"), "none")
    test.assert_eq(address_text("ws://:80/chat"), "none")
    test.assert_eq(address_text("ws://user@example.com/chat"), "none")
    test.assert_eq(address_text("ws://example.com:0/chat"), "none")
    test.assert_eq(address_text("ws://example.com:65536/chat"), "none")
    test.assert_eq(address_text("ws://example.com:http/chat"), "none")
    test.assert_eq(address_text("ws://[::1/chat"), "none")
    test.assert_eq(address_text("ws://[::1]x/chat"), "none")

// ── Messages ────────────────────────────────────────────────────────

@test
fn test_every_connection_fault_reads_as_a_sentence() [io]
    let faults: [WsConnError] = [
        WsSocketFailed(IoBrokenPipe), WsUpgradeRefused(MissingKey), WsUpgradeAnswered(403, [1, 2]),
        WsFrameRefused(UnmaskedClientFrame), WsFrameNotBuildable(ClientFrameNeedsMask),
        WsCloseTimedOut(5000), WsPongTimedOut(10000), WsExtensionNotNegotiated("permessage-deflate"),
        WsInflateFailed(BadBlockType(3)), WsMessageTooLargeToAssemble(70000, 65536), WsTextNotUtf8,
        WsHeadNotBuildable(MissingHost), WsAlreadyClosing,
        WsPeerClosedFirst(WsClose { code: GoingAway, reason: "" })]
    for f in faults
        test.assert(str.len(f.message()) > 10)
    test.assert(str.contains(WsUpgradeAnswered(403, [1, 2]).message(), "403"))
    test.assert(str.contains(WsCloseTimedOut(5000).message(), "5000"))
    test.assert(str.contains(WsMessageTooLargeToAssemble(70000, 65536).message(), "65536"))
    test.assert(str.contains(WsPeerClosedFirst(WsClose { code: GoingAway, reason: "" }).message(), "1001"))

@test
fn test_each_fault_owes_the_peer_the_right_code_or_none() [io]
    test.assert_eq(fault_text(Some(WsFrameRefused(ReservedBitSet(1)))), "err:1002")
    test.assert_eq(fault_text(Some(WsFrameNotBuildable(ClientFrameNeedsMask))), "err:1011")
    test.assert_eq(fault_text(Some(WsExtensionNotNegotiated("x"))), "err:1002")
    test.assert_eq(fault_text(Some(WsInflateFailed(BadBlockType(3)))), "err:1007")
    test.assert_eq(fault_text(Some(WsMessageTooLargeToAssemble(2, 1))), "err:1009")
    test.assert_eq(fault_text(Some(WsTextNotUtf8)), "err:1007")
    test.assert_eq(fault_text(Some(WsUpgradeRefused(MissingKey))), "err:none")
    test.assert_eq(fault_text(Some(WsUpgradeAnswered(403, []))), "err:none")
    test.assert_eq(fault_text(Some(WsCloseTimedOut(1))), "err:none")
    test.assert_eq(fault_text(Some(WsPongTimedOut(1))), "err:none")
    test.assert_eq(fault_text(Some(WsHeadNotBuildable(MissingHost))), "err:none")
    test.assert_eq(fault_text(Some(WsAlreadyClosing)), "err:none")
    test.assert_eq(fault_text(Some(WsPeerClosedFirst(WsClose { code: GoingAway, reason: "" }))), "err:none")

@test
fn test_which_faults_are_worth_another_connection() [io]
    test.assert(wsconnerr.is_reconnectable(WsSocketFailed(IoBrokenPipe)))
    test.assert(wsconnerr.is_reconnectable(WsCloseTimedOut(1)))
    test.assert(wsconnerr.is_reconnectable(WsPongTimedOut(1)))
    test.assert(wsconnerr.is_reconnectable(WsUpgradeAnswered(503, [])))
    test.assert(wsconnerr.is_reconnectable(WsUpgradeAnswered(429, [])))
    test.assert(wsconnerr.is_reconnectable(WsUpgradeAnswered(408, [])))
    test.assert(not wsconnerr.is_reconnectable(WsUpgradeAnswered(401, [])))
    test.assert(not wsconnerr.is_reconnectable(WsUpgradeRefused(MissingKey)))
    test.assert(not wsconnerr.is_reconnectable(WsFrameRefused(UnmaskedClientFrame)))
    test.assert(not wsconnerr.is_reconnectable(WsFrameNotBuildable(ClientFrameNeedsMask)))
    test.assert(not wsconnerr.is_reconnectable(WsExtensionNotNegotiated("x")))
    test.assert(not wsconnerr.is_reconnectable(WsInflateFailed(BadBlockType(3))))
    test.assert(not wsconnerr.is_reconnectable(WsMessageTooLargeToAssemble(2, 1)))
    test.assert(not wsconnerr.is_reconnectable(WsTextNotUtf8))
    test.assert(not wsconnerr.is_reconnectable(WsHeadNotBuildable(MissingHost)))
    test.assert(not wsconnerr.is_reconnectable(WsAlreadyClosing))
    test.case("a peer that is going away, restarting or busy asks to be tried again")
    for code in [GoingAway, ServiceRestart, TryAgainLater]
        test.assert(wsconnerr.is_reconnectable(WsPeerClosedFirst(WsClose { code: code, reason: "" })))
    test.assert(not wsconnerr.is_reconnectable(WsPeerClosedFirst(WsClose { code: PolicyViolation, reason: "" })))

@test
fn test_a_server_status_comes_only_from_a_handshake_fault() [io]
    test.assert_eq(wsconnerr.http_status_for(WsUpgradeRefused(UnsupportedVersion(8))) ?? 0, 426)
    test.assert_eq(wsconnerr.http_status_for(WsUpgradeRefused(MissingKey)) ?? 0, 400)
    test.assert_eq(wsconnerr.http_status_for(WsTextNotUtf8) ?? 0, 0)
    test.assert_eq(wsconnerr.http_status_for(WsUpgradeAnswered(403, [])) ?? 0, 0)

// ── A loopback socket ───────────────────────────────────────────────

fn events_of(t: Result<WsTurn, WsConnError>) -> Str
    match t
        Err(e)   => "error:" + e.message()
        Ok(turn) =>
            var out: [Str] = []
            for ev in turn.events
                list.push(out, event_text(ev))
            str.join(out, "|")

// Two ends of one TCP connection with the upgrade done between them.
struct Pair
    client: WsTcp
    server: WsTcp
    cconn: WsConn
    sconn: WsConn

fn connected_pair() -> ?Pair [io, net, rand, mutate]
    match wstrans.listen("127.0.0.1", 0)
        Err(_) => None
        Ok(l)  =>
            let port = net.local_port(l.listener.sock)
            match wstrans.dial_tcp("127.0.0.1", port)
                Err(_) => None
                Ok(ct) =>
                    match wstrans.accept(l)
                        Err(_)  => None
                        Ok(acc) => upgraded(ct, acc, port)

fn upgraded(ct: WsTcp, acc: WsAccepted, port: Int) -> ?Pair [io, net, rand, mutate]
    let addr = WsAddress { secure: false, host: "127.0.0.1", port: port, target: "/loop" }
    let _ = wstrans.stream_of(ct).set_recv_timeout(2000)
    let _ = wstrans.stream_of(acc.transport).set_recv_timeout(2000)
    match wsclient.handshake_with_nonce(wsclient.request(addr), rfc_nonce())
        Err(_) => None
        Ok(h)  =>
            match wsclient.request_bytes(h)
                Err(_)   => None
                Ok(head) =>
                    let _ = wstrans.send_all(ct, head)
                    match wsserve.accept_upgrade(acc.transport, wsserve.policy())
                        Err(_)    => None
                        Ok(sconn) =>
                            match wstrans.read_head(ct, ReadsResponses)
                                Err(_)  => None
                                Ok(got) =>
                                    match got.event
                                        ResponseHead(resp) =>
                                            match wsclient.accept_response(h, resp, wsconn.default_options())
                                                Err(_)    => None
                                                Ok(cconn) => Some(Pair { client: ct, server: acc.transport,
                                                                         cconn: cconn, sconn: sconn })
                                        _                  => None

@test
fn test_a_message_crosses_a_real_socket_in_both_directions() [io, net, rand, mutate]
    match connected_pair()
        None    => test.assert(false)
        Some(p) =>
            test.case("client to server")
            match wsconn.send_text(p.cconn, p.client, str_bytes("over tcp"), 0)
                Err(_)   => test.assert(false)
                Ok(sent) =>
                    test.assert_eq(events_of(wsconn.pump(p.sconn, p.server, 1)), "T:over tcp")

                    test.case("server to client")
                    match wsconn.send_binary(p.sconn, p.server, [1, 2, 3], 2)
                        Err(_)   => test.assert(false)
                        Ok(back) =>
                            test.assert_eq(events_of(wsconn.pump(sent.conn, p.client, 3)), "B:010203")

                            test.case("nothing to read is a receive deadline and not a fault")
                            let _ = wstrans.stream_of(p.server).set_recv_timeout(30)
                            test.assert_eq(events_of(wsconn.pump(back.conn, p.server, 4)), "")

@test
fn test_the_close_handshake_completes_over_a_real_socket() [io, net, rand, mutate]
    match connected_pair()
        None    => test.assert(false)
        Some(p) =>
            match wsconn.close(p.cconn, p.client, WsClose { code: NormalClosure, reason: "done" }, 0)
                Err(_)   => test.assert(false)
                Ok(sent) =>
                    test.case("the server answers the close")
                    match wsconn.pump(p.sconn, p.server, 1)
                        Err(_)   => test.assert(false)
                        Ok(turn) =>
                            test.assert_eq(events_of(Ok(turn)), "close:1000|done")

                            test.case("and the client sees the answer")
                            test.assert_eq(events_of(wsconn.pump(sent.conn, p.client, 2)), "done")
                    test.assert_eq(p.client.ws_close(), None)
                    test.assert_eq(p.server.ws_close(), None)
                    test.assert(p.client.ws_is_open())

@test
fn test_a_peer_that_drops_the_socket_is_a_failed_connection() [io, net, rand, mutate]
    match connected_pair()
        None    => test.assert(false)
        Some(p) =>
            test.assert_eq(p.client.ws_close(), None)
            test.assert_eq(events_of(wsconn.pump(p.sconn, p.server, 1)), "error:the transport failed: closed")

@test
fn test_a_dial_to_a_closed_port_is_an_error_and_a_listener_can_be_asked_for_its_port() [io, net]
    test.case("nothing listens on port 1")
    match wstrans.dial_tcp("127.0.0.1", 1)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "127.0.0.1:1"))

    test.case("a TLS dial to the same port refuses the same way")
    match wstrans.dial_tls("127.0.0.1", 1, wstrans.tls_for("localhost"))
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "TLS to 127.0.0.1:1 failed"))

    test.case("a port nobody may bind")
    match wstrans.listen("203.0.113.1", 80)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(e.message(), "203.0.113.1:80"))

fn write_fails(t: WsTcp) -> Bool [io, net]
    let big = bytes.zeros(65536)
    match t.ws_send(big)
        Ok(_)  => false
        Err(_) => true

@test
fn test_writing_to_a_socket_the_peer_closed_fails() [io, net, rand, mutate]
    match connected_pair()
        None    => test.assert(false)
        Some(p) =>
            test.assert_eq(p.client.ws_close(), None)
            var failed = false
            var tries = 0
            while tries < 20 and not failed
                failed = write_fails(p.server)
                tries = tries + 1
            test.assert(failed)

@test
fn test_accepting_on_a_closed_listener_fails() [io, net]
    match wstrans.listen("127.0.0.1", 0)
        Err(_) => test.assert(false)
        Ok(l)  =>
            l.listener.close()
            match wstrans.accept(l)
                Ok(_)  => test.assert(false)
                Err(e) => test.assert_eq(e.message(), "accept failed")
